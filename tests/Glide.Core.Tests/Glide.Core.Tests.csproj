<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Avalonia.Headless" Version="11.3.20" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
    <ProjectReference Include="..\..\src\Glide.Core\Glide.Core.csproj" />
    <ProjectReference Include="..\..\src\Glide.Imaging\Glide.Imaging.csproj" />
    <ProjectReference Include="..\..\src\Glide.Diagnostics\Glide.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Glide.App\Glide.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Glide.Tests.Support" />
    <Compile Include="..\TestSupport\*.cs" Link="TestSupport\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\overlay-video.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\overlay-video-vp9.webm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Codecs\*" Exclude="Fixtures\Codecs\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Pdn\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Jpeg\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stage C: GlideSettingsState and its companions live in Glide.Core.Settings (Avalonia-free). -->
    <Using Include="Glide.Core.Settings" />
  </ItemGroup>
</Project>
