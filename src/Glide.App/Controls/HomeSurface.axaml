<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Glide.App.Controls"
             x:Class="Glide.App.Controls.HomeSurface"
             x:Name="Root">
  <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,70">
          <Grid Margin="31,24,18,18" RowDefinitions="Auto,Auto,Auto">
            <StackPanel>
              <TextBlock x:Name="HomeHeadingText" Text="Glide" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock x:Name="HomeSubtitleText" Text="Open an image with Ctrl+O or drop one here, or pick up where you left off below."
                         Foreground="{DynamicResource BrushMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Shown when there is no Recent list to display (history off, hidden or empty). -->
            <StackPanel x:Name="HomeEmptyState" Grid.Row="1" Margin="0,20,0,0" Spacing="10" IsVisible="False">
              <TextBlock x:Name="HomeEmptyText" Text="No recent pictures yet." Foreground="{DynamicResource BrushMuted}" FontSize="12.5" TextWrapping="Wrap"/>
              <Button Classes="recentClear" Click="OpenFileClicked" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6"><controls:GlideIconView Kind="Open" Width="14" Height="14"/><TextBlock Text="Open image…" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>


            <Border x:Name="RecentHistoryPanel" Grid.Row="2" IsVisible="False" Classes="recentPanel" Margin="0,20,0,0">
              <Grid RowDefinitions="Auto,Auto" Margin="14,11">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:GlideIconView Kind="History" Width="16" Height="16" IconBrush="{DynamicResource BrushAccent}" StrokeWidth="1.5" VerticalAlignment="Center"/>
                    <TextBlock Text="Recent" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button x:Name="RecentResizeButton" Grid.Column="1" Classes="recentClear" Click="ResizeRecentHistoryClicked" ToolTip.Tip="Resize Recent: Normal → Compact → Large">
                    <controls:GlideIconView x:Name="RecentResizeIcon" Kind="Expand" Width="14" Height="14"/>
                  </Button>
                  <Button Grid.Column="2" Classes="recentClear" Content="Clear" Click="ClearRecentHistoryClicked" ToolTip.Tip="Clear recent file and folder history"/>
                  <Button Grid.Column="3" Classes="recentClear" Click="CloseRecentHistoryClicked" ToolTip.Tip="Hide Recent from Home. Restore it in Settings → General.">
                    <controls:GlideIconView Kind="Close" Width="12" Height="12"/>
                  </Button>
                </Grid>
                <ScrollViewer x:Name="RecentHistoryScroll" Grid.Row="1" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="RecentHistoryHost" Spacing="3"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>

        <Border x:Name="HomeStatusSurface" Classes="statusSurface legacyViewerStatus" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="14,0,14,14" Height="58">
          <Grid ColumnDefinitions="*,Auto" Margin="16,8,8,8">
            <TextBlock x:Name="HomeStatusText" Text="Glide  •  Drop an image here or Ctrl+O" FontSize="12.5" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
            <StackPanel x:Name="HomeStatusControlsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Classes="statusIcon legacyStatusIcon" IsEnabled="False" ToolTip.Tip="Zoom out"><controls:GlideIconView Kind="ZoomOut" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon" IsEnabled="False" ToolTip.Tip="Zoom in"><controls:GlideIconView Kind="ZoomIn" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon" IsEnabled="False" ToolTip.Tip="Fit width"><controls:GlideIconView Kind="FitWidth" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon" IsEnabled="False" ToolTip.Tip="Fit height"><controls:GlideIconView Kind="FitHeight" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon" IsEnabled="False" ToolTip.Tip="Slideshow"><controls:GlideIconView Kind="Play" Classes="statusGlyph"/></Button>
              <Button x:Name="HomeOptionsButton" Classes="statusIcon legacyStatusIcon" Click="SettingsClicked" ToolTip.Tip="Settings"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Classes="modernSettingsGlyph"/></Button>
              <Border Width="6"/>
              <Button Classes="statusIcon legacyStatusIcon nav" IsEnabled="False" ToolTip.Tip="First image"><controls:GlideIconView Kind="First" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon nav" IsEnabled="False" ToolTip.Tip="Previous image"><controls:GlideIconView Kind="Previous" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon nav" IsEnabled="False" ToolTip.Tip="Next image"><controls:GlideIconView Kind="Next" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon nav" IsEnabled="False" ToolTip.Tip="Last image"><controls:GlideIconView Kind="Last" Classes="statusGlyph"/></Button>
              <Button x:Name="HomeStatusCollapseButton" Classes="statusIcon legacyStatusIcon" Click="CollapseStatusClicked" ToolTip.Tip="Collapse status surface"><controls:GlideIconView Kind="Collapse" Classes="statusGlyph"/></Button>
              <Button Classes="statusIcon legacyStatusIcon" Click="CloseStatusClicked" ToolTip.Tip="Hide status surface"><controls:GlideIconView Kind="Close" Classes="statusGlyph"/></Button>
            </StackPanel>
          </Grid>
        </Border>
      
  </Grid>
</UserControl>
