<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Glide.App.Controls"
        x:Class="Glide.App.Settings.SettingsWindow"
        Width="930" Height="630" MinWidth="720" MinHeight="480"
        Title="Glide Settings" Icon="/Assets/Glide.ico"
        Background="{DynamicResource BrushWindow}">
  <Window.Styles>
    <!-- Settings-only rhythm: the category buttons are tighter than the shared theme default (50) so all eight fit a small window. -->
    <Style Selector="Button.settingsNav"><Setter Property="Height" Value="44"/></Style>
    <!-- Footer "Always expand" switch (approved mockup: 32x18 pill, 12 px knob, 3 px inset). -->
    <Style Selector="ToggleButton.footerSwitch">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Track" Width="32" Height="18" CornerRadius="9" Background="#444444">
            <Border x:Name="PART_Knob" Width="12" Height="12" CornerRadius="6" Background="#EEEEEE" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.footerSwitch:checked /template/ Border#PART_Track"><Setter Property="Background" Value="{DynamicResource BrushAccent}"/></Style>
    <Style Selector="ToggleButton.footerSwitch:checked /template/ Border#PART_Knob"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,3,0"/></Style>
  </Window.Styles>
  <!-- Responsive Glide Settings shell. Avalonia already works in device-independent pixels;
       a fixed 1080x810 Viewbox caused the empty top/bottom bands reported during live resize.
       Layout contract (see SettingsWindowLayoutTests): the nav column is a FIXED width that just fits the longest
       label plus padding, the content column is * with no fixed right gutter (20 DIP padding both sides), and the
       header and footer rows are compact so the page gets the height on small displays. -->
  <Grid x:Name="ReferenceRoot" Focusable="True" RowDefinitions="64,*,76" ColumnDefinitions="224,*">
      <!-- brand + search -->
      <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushSettingsRail}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
        <StackPanel Margin="18,0,10,0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Glide Settings" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Search or browse by category" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BrushWindow}">
        <Grid ColumnDefinitions="*,200" ColumnSpacing="10" Margin="20,0,20,0" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Classes="settingsSearch" Watermark="Search settings... (Ctrl+F)" TextChanged="SearchChanged"/>
          <ComboBox x:Name="SearchCategoryCombo" Grid.Column="1" Width="200" SelectedIndex="0" SelectionChanged="SearchCategoryChanged" ToolTip.Tip="Limit Settings search to one category. All categories is the default.">
            <ComboBoxItem Content="All categories"/><ComboBoxItem Content="General &amp; startup"/><ComboBoxItem Content="Appearance &amp; viewing"/><ComboBoxItem Content="Window &amp; navigation"/><ComboBoxItem Content="Tabs &amp; status bar"/><ComboBoxItem Content="Mouse &amp; keyboard"/><ComboBoxItem Content="Slideshow &amp; overlays"/><ComboBoxItem Content="Performance"/><ComboBoxItem Content="Windows &amp; developer"/>
          </ComboBox>
        </Grid>
      </Border>

      <!-- category rail -->
      <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushSettingsRail}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavigationRail" Margin="0,0,0,8" Spacing="0">
            <Button Classes="settingsNav selected" Tag="General" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="General" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="General &amp; startup" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Performance" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Performance" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Performance" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Appearance" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Appearance" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Appearance &amp; viewing" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Interface" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Interface" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Window &amp; navigation" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Tabs" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Tabs" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Tabs &amp; status bar" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Mouse" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Mouse" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Mouse &amp; keyboard" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Slideshow" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Slideshow" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Slideshow &amp; overlays" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
            <Button Classes="settingsNav" Tag="Windows" Click="CategoryClicked"><Grid ColumnDefinitions="28,*"><controls:GlideIconView Kind="Windows" Classes="navGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Windows &amp; developer" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- content -->
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
        <StackPanel Margin="20,2,20,16" Spacing="8">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock x:Name="PageTitle" Text="General &amp; startup" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="PageSubtitle" Text="What opens at launch and in new tabs, history, updates and saved profiles" Margin="0,2,0,0" Foreground="{DynamicResource BrushMuted}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,2,0,0">
              <Button x:Name="ExpandAllCardsButton" Classes="secondaryAction" Height="34" MinWidth="0" Padding="12,4" Content="Expand all" Click="ExpandAllCardsClicked" ToolTip.Tip="Open every card on this page"/>
              <Button x:Name="CollapseAllCardsButton" Classes="secondaryAction" Height="34" MinWidth="0" Padding="12,4" Content="Collapse all" Click="CollapseAllCardsClicked" ToolTip.Tip="Close every card on this page"/>
            </StackPanel>
          </Grid>

          <!-- GENERAL &amp; STARTUP -->
          <StackPanel x:Name="GeneralPanel" Spacing="0">
            <controls:SettingsCard CardId="general-startup" Title="Startup and new tabs" Subtitle="What opens when Glide starts, in a new tab, and on Home" Icon="Home" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="205,245,*" Margin="6,0,0,0"><TextBlock Text="When Glide opens" VerticalAlignment="Center"/><ComboBox x:Name="StartupActionCombo" Grid.Column="1" Width="235"><ComboBoxItem Content="Welcome tab"/><ComboBoxItem Content="Open last session"/><ComboBoxItem Content="Custom"/></ComboBox></Grid>
                <Grid ColumnDefinitions="205,*,Auto,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="Startup custom path" VerticalAlignment="Center"/><TextBox x:Name="StartupCustomPathBox" Grid.Column="1" IsReadOnly="True" Watermark="Choose an image or folder" ToolTip.Tip="Used when When Glide opens is Custom. A folder opens in an Explorer tab; an image file opens that image."/><Button Grid.Column="2" Classes="secondaryAction" Content="File..." Click="BrowseStartupFileClicked"/><Button Grid.Column="3" Classes="secondaryAction" Content="Folder..." Click="BrowseStartupFolderClicked"/></Grid>
                <Grid ColumnDefinitions="205,245,*" Margin="6,0,0,0"><TextBlock Text="New tab opens" VerticalAlignment="Center"/><ComboBox x:Name="NewTabActionCombo" Grid.Column="1" Width="235"><ComboBoxItem Content="Welcome tab"/><ComboBoxItem Content="Explorer tab"/><ComboBoxItem Content="Custom"/></ComboBox></Grid>
                <CheckBox x:Name="NewExplorerTabLastLocationCheck" IsVisible="False" Content="New Explorer tabs use their last navigated directory" ToolTip.Tip="Default: each new Explorer tab starts in the last directory navigated by the Explorer-tab scope. This history is independent of Open File, overlays, profiles and other pickers."/>
                <Grid IsVisible="False" ColumnDefinitions="205,*,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="Default New Explorer tab directory" VerticalAlignment="Center"/><TextBox x:Name="NewExplorerTabDefaultDirectoryBox" Grid.Column="1"/><Button Grid.Column="2" Classes="secondaryAction" Content="Browse..." Click="BrowseNewExplorerDefaultDirectoryClicked"/></Grid>
                <Grid ColumnDefinitions="205,*,Auto,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="New-tab custom path" VerticalAlignment="Center"/><TextBox x:Name="NewTabCustomPathBox" Grid.Column="1" IsReadOnly="True" Watermark="Choose an image or folder" ToolTip.Tip="Used when New tab opens is Custom (a folder opens in an Explorer tab, an image opens as an image) or Explorer tab (opens this folder instead of the last-used one)."/><Button Grid.Column="2" Classes="secondaryAction" Content="File..." Click="BrowseNewTabFileClicked"/><Button Grid.Column="3" Classes="secondaryAction" Content="Folder..." Click="BrowseNewTabFolderClicked"/></Grid>
                <Grid ColumnDefinitions="225,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Home page" VerticalAlignment="Center"/>
                  <ComboBox x:Name="HomePageCombo" Grid.Column="1" Width="220">
                    <ComboBoxItem Content="Welcome page"/>
                    <ComboBoxItem Content="Recent pictures page"/>
                    <ComboBoxItem Content="Explorer page"/>
                  </ComboBox>
                </Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="general-history" Title="History and Open locations" Subtitle="Recent files, Home's recent list and where Open starts" Icon="History" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="RecentHistoryCheck" Content="Keep recent file/folder history"/>
                <Grid ColumnDefinitions="205,150,*" Margin="6,0,0,0"><TextBlock Text="History size (1-16)" VerticalAlignment="Center"/><NumericUpDown x:Name="HistorySizeBox" Grid.Column="1" Minimum="1" Maximum="16" HorizontalAlignment="Left"/></Grid>
                <CheckBox x:Name="ShowRecentOnHomeCheck" Content="Show recently opened files/folders on Home" ToolTip.Tip="Hides only the Home/Welcome Recent section; it does not erase or disable recent-history storage."/>
                <CheckBox x:Name="RememberLastOpenCheck" Content="Remember last main-viewer Open / Open Folder location" ToolTip.Tip="Open Image and Open Folder start from the last successful main-viewer location."/>
                <Grid ColumnDefinitions="205,*,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="Default Open File directory" VerticalAlignment="Center"/><TextBox x:Name="OpenFileDefaultDirectoryBox" Grid.Column="1"/><Button Grid.Column="2" Classes="secondaryAction" Content="Browse..." Click="BrowseOpenDefaultDirectoryClicked"/></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="general-updates" Title="Updates" Subtitle="Check GitHub for new versions" Icon="Refresh" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="UpdateCheckDailyCheck" Content="Check for updates once a day"/>
                <CheckBox x:Name="UpdateDontRemindCheck">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Don't remind me about updates"/>
                    <TextBlock Text="(turns the prompt off)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource BrushMuted}"/>
                  </StackPanel>
                </CheckBox>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="6,4,0,0">
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="UpdateLastCheckedText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="UpdateResultText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="UpdateViewButton" Classes="secondaryAction" Content="View on GitHub" IsVisible="False" Click="UpdateViewClicked" ToolTip.Tip="Opens the release page of the new version in your browser. Nothing is downloaded or installed by Glide."/>
                    <Button x:Name="UpdateCheckNowButton" Classes="secondaryAction" Content="Check now" Click="UpdateCheckNowClicked" ToolTip.Tip="Asks GitHub right now whether a newer version exists. Works even when the daily check is off."/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="UpdatePrivacyNote" Text="Only a plain request to github.com is sent: no personal data, no telemetry. Nothing is downloaded or installed automatically." Classes="phaseNote"/>
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard CardId="general-settings-window" Title="Settings window" Subtitle="Search results and the discard-changes warning" Icon="Settings" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="SearchShowRelatedCheck" Content="Show related results in settings search (after the title matches)" ToolTip.Tip="Settings search always lists settings whose title matches first. When on, it also lists related settings that match only through a description, tooltip or search term, after the title matches. Turn off to see title matches only."/>
                <!-- A link: the tooltip delays live on Appearance &amp; viewing > Tooltips. -->
                <Button x:Name="SettingsTooltipLinkButton" Click="TooltipDelayLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,8" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:GlideIconView Kind="Info" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="settingsCardTitle" Text="Tooltip delay →"/>
                      <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="How long tooltips wait in this window. Opens Appearance &amp; viewing > Tooltips."/>
                    </StackPanel>
                  </Grid>
                </Button>
                <CheckBox x:Name="ConfirmDiscardSettingsCheck" Content="Warn before discarding unapplied Settings changes" ToolTip.Tip="Controls the discard confirmation shown by Cancel and window close when there are unapplied settings changes."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="general-profiles" Title="Profiles and presets" Subtitle="Interaction presets, named profiles, import and export" Icon="Profiles" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Presets change interaction/hotkey behaviour as one staged Settings edit. Named user profiles can be added freely and exported/imported as portable profile files." Classes="phaseNote"/>
                <Grid ColumnDefinitions="205,300,Auto,*" Margin="6,2,0,0">
                  <TextBlock Text="Interaction preset" VerticalAlignment="Center"/>
                  <ComboBox x:Name="PresetCombo" Grid.Column="1" Width="285" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="Glide default"/><ComboBoxItem Content="Windows Photos"/><ComboBoxItem Content="IrfanView"/><ComboBoxItem Content="nomacs"/><ComboBoxItem Content="FastStone"/><ComboBoxItem Content="XnView MP"/></ComboBox>
                  <Button Grid.Column="2" Classes="secondaryAction" Content="Apply preset" Click="ApplyPresetClicked" Margin="10,0,0,0"/>
                </Grid>
                <TextBlock Text="User profiles" Classes="settingsSectionLabel" FontWeight="SemiBold" Margin="4,8,0,0"/>
                <StackPanel x:Name="ProfileRowsHost" Spacing="7" Margin="6,0,0,0"/>
                <Button x:Name="AddProfileButton" Classes="secondaryAction" Click="AddProfileClicked" HorizontalAlignment="Left" MinWidth="160" Margin="6,2,0,0" ToolTip.Tip="Create and name another user profile"><StackPanel Orientation="Horizontal" Spacing="8"><controls:GlideIconView Kind="Plus" Width="16" Height="16"/><TextBlock Text="Add profile" VerticalAlignment="Center"/></StackPanel></Button>
                <Grid ColumnDefinitions="205,*,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="Default profile directory" VerticalAlignment="Center"/><TextBox x:Name="ProfileDefaultDirectoryBox" Grid.Column="1"/><Button Grid.Column="2" Classes="secondaryAction" Content="Browse..." Click="BrowseProfileDefaultDirectoryClicked"/></Grid>
                <TextBlock Text="Portable configuration" Classes="settingsSectionLabel" FontWeight="SemiBold" Margin="4,8,0,0"/>
                <WrapPanel ItemSpacing="10" LineSpacing="8" controls:SettingsCard.SettingIds="profiles.import,profiles.export"><Button Classes="secondaryAction" Content="Import settings..." Click="ImportSettingsClicked"/><Button Classes="secondaryAction" Content="Export settings..." Click="ExportSettingsClicked"/></WrapPanel>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- PERFORMANCE -->
          <StackPanel x:Name="PerformancePanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="performance-quality" Title="Quality profile" Subtitle="Balance speed and image quality while browsing" Icon="HighQuality" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Glide uses a staged first-frame → full-resolution pipeline. Profiles coordinate preview size, interpolation, refinement, prefetch and decoded-neighbour policy; advanced controls remain independently editable." Classes="phaseNote" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="270,240,Auto,*" Margin="6,0,0,0"><TextBlock Text="Browsing / image quality profile" VerticalAlignment="Center"/><ComboBox x:Name="InitialQualityCombo" Grid.Column="1" Width="240" SelectionChanged="PerformanceProfileChanged" ToolTip.Tip="Stock profiles apply coordinated defaults. Any non-matching edit automatically becomes User custom."><ComboBoxItem Content="Maximum speed"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Maximum quality"/><ComboBoxItem Content="User custom"/></ComboBox><Button x:Name="SaveUserPerformancePresetButton" Grid.Column="2" Classes="secondaryAction" Content="Save custom" Click="SaveUserPerformancePresetClicked" Margin="10,0,0,0" ToolTip.Tip="Save the current performance controls as your reusable User custom preset."/></Grid>
                <Grid ColumnDefinitions="270,240,*" Margin="6,0,0,0"><TextBlock Text="Quality while dragging / panning" VerticalAlignment="Center"/><ComboBox x:Name="InteractivePanQualityCombo" Grid.Column="1" Width="240" ToolTip.Tip="The Balanced and Maximum quality presets default to Full quality while moving. Fast prefers the lightest available interaction preview. This control remains independently overridable."><ComboBoxItem Content="Fast"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Full quality"/></ComboBox></Grid>
                <CheckBox x:Name="AdaptiveFastPreviewCheck" Content="Decoder-scaled first useful frame for large images"/>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Full-resolution refinement delay (ms)" VerticalAlignment="Center"/><NumericUpDown x:Name="AdaptivePreviewDelayBox" Grid.Column="1" Minimum="5" Maximum="500"/></Grid>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="First view decode size (% of window, 0 = preset)" VerticalAlignment="Center"/><NumericUpDown x:Name="FirstViewScaleBox" Grid.Column="1" Minimum="0" Maximum="100" Increment="5" ToolTip.Tip="0 uses the preset value per format: Maximum quality 100, Balanced 75, Maximum speed 25."/></Grid>
                <Grid ColumnDefinitions="270,240,*" Margin="6,0,0,0"><TextBlock Text="Decode full resolution" VerticalAlignment="Center"/><ComboBox x:Name="FullRefineCombo" Grid.Column="1" Width="240" ToolTip.Tip="Preset default: When idle for Maximum quality and Balanced, On zoom only for Maximum speed."><ComboBoxItem Content="Preset default"/><ComboBoxItem Content="Immediately"/><ComboBoxItem Content="When idle"/><ComboBoxItem Content="On zoom only"/></ComboBox></Grid>
                <CheckBox x:Name="BackgroundRefinementCheck" Content="Refine preview to full resolution while idle"/>
                <CheckBox x:Name="ProgressiveColorCheck" Content="Keep progressive JPEG first frame in colour" ToolTip.Tip="On: request an early progressive level that normally contains luminance and chroma, avoiding a black-and-white first-frame flash. All stock profiles keep this enabled by default; you can still disable it manually."/>
                <TextBlock Classes="phaseNote" Text="All stock profiles, including Maximum speed, default to a colour first frame. This checkbox remains independently editable after choosing any profile; disabling it permits the earliest luminance-only progressive level when a codec exposes one. Settled refinement always restores final fidelity." TextWrapping="Wrap" Margin="6,-4,8,2"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="performance-prefetch" Title="Prefetch" Subtitle="Prepare nearby images and folders before you get there" Icon="Next" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="PrefetchCheck" Content="Predictively prepare neighbouring images"/>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Neighbour prefetch depth per direction" VerticalAlignment="Center"/><NumericUpDown x:Name="PrefetchDepthBox" Grid.Column="1" Minimum="1" Maximum="30" ToolTip.Tip="Images prefetched in each direction. Balanced and Maximum quality default to 5; Maximum speed defaults to 3. Changing it manually makes the performance profile User custom."/></Grid>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Prefetch decode size (% of window, 0 = preset)" VerticalAlignment="Center"/><NumericUpDown x:Name="PrefetchScaleBox" Grid.Column="1" Minimum="0" Maximum="100" Increment="5" ToolTip.Tip="0 uses the preset value per format: Maximum quality 100, Balanced 50, Maximum speed 12."/></Grid>
                <CheckBox x:Name="PrefetchSiblingFoldersCheck" Content="Prefetch surrounding sibling folders" ToolTip.Tip="Lightly warms only the chosen leading images from the nearest previous and next sibling folders."/>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Pictures per surrounding folder" VerticalAlignment="Center"/><NumericUpDown x:Name="PrefetchSiblingFolderCountBox" Grid.Column="1" Minimum="1" Maximum="30"/></Grid>
                <CheckBox x:Name="SequentialReadCheck" Content="Use sequential read hints for foreground image streams"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="performance-rapid" Title="Fast browsing previews" Subtitle="Lighter frames while you hold an arrow key or spin the wheel" Icon="FrameNext" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Rapid navigation preview (px)" VerticalAlignment="Center"/><NumericUpDown x:Name="RapidBrowsePreviewBox" Grid.Column="1" Minimum="640" Maximum="4096" ToolTip.Tip="Long edge of the temporary frame used while holding Left/Right or rapidly scrolling through images. Profiles choose a default; you can override it afterwards."/></Grid>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Rapid preview longest side (px)" VerticalAlignment="Center"/><NumericUpDown x:Name="RapidPreviewBox" Grid.Column="1" Minimum="480" Maximum="4096"/></Grid>
                <TextBlock Classes="phaseNote" Text="Rapid navigation automatically uses reduced frames only during sustained keyboard holds or a fast wheel burst. A single key press or isolated wheel notch remains a normal full-quality navigation step, and the selected image refines after input settles." TextWrapping="Wrap" Margin="6,-4,8,2"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="performance-memory" Title="Memory and caches" Subtitle="How much memory Glide keeps for images" Icon="Performance" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Compressed cache (items)" VerticalAlignment="Center"/><NumericUpDown x:Name="CacheItemsBox" Grid.Column="1" Minimum="2" Maximum="64"/></Grid>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Compressed cache budget (MB)" VerticalAlignment="Center"/><NumericUpDown x:Name="CompressedCacheMbBox" Grid.Column="1" Minimum="32" Maximum="2048"/></Grid>
                <Grid ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Decoded-frame budget (MB)" VerticalAlignment="Center"/><NumericUpDown x:Name="DecodedCacheMbBox" Grid.Column="1" Minimum="32" Maximum="2048"/></Grid>
                <CheckBox x:Name="PurgeCacheCheck" Content="Purge compressed and decoded caches when Glide is minimized"/>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- APPEARANCE &amp; VIEWING -->
          <StackPanel x:Name="AppearancePanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="appearance-theme" Title="Theme and colours" Subtitle="Theme, accent, glow and the image background" Icon="Appearance" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="245,210,*" Margin="6,0,0,0"><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Neutral"/><ComboBoxItem Content="Light"/></ComboBox></Grid>
                <Grid IsVisible="False" ColumnDefinitions="245,210,*" Margin="6,0,0,0"><TextBlock Text="Explorer theme" VerticalAlignment="Center"/><ComboBox x:Name="ExplorerThemeCombo" Grid.Column="1" Width="210" ToolTip.Tip="Follow Glide theme is the default. Override only the Glide Explorer surface if you prefer a different light/neutral/dark treatment."><ComboBoxItem Content="Follow Glide theme"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Neutral"/><ComboBoxItem Content="Light"/></ComboBox></Grid>
                <Grid ColumnDefinitions="245,210,110,*" Margin="6,0,0,0"><TextBlock Text="Accent colour" VerticalAlignment="Center"/><ComboBox x:Name="AccentCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Glide blue"/><ComboBoxItem Content="Cyan"/><ComboBoxItem Content="Teal"/><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Lime"/><ComboBoxItem Content="Violet"/><ComboBoxItem Content="Indigo"/><ComboBoxItem Content="Magenta"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Crimson"/><ComboBoxItem Content="Orange"/><ComboBoxItem Content="Amber"/><ComboBoxItem Content="Custom"/></ComboBox><Button Grid.Column="2" Classes="secondaryAction" Content="Pick..." Click="PickAccentColorClicked" Margin="8,0,0,0"/></Grid>
                <Grid ColumnDefinitions="245,210,110,*" Margin="6,0,0,0"><TextBlock Text="Glow colour" VerticalAlignment="Center"/><ComboBox x:Name="GlowCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Follow accent"/><ComboBoxItem Content="Ice blue"/><ComboBoxItem Content="Cyan"/><ComboBoxItem Content="Teal"/><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Violet"/><ComboBoxItem Content="Magenta"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Amber"/><ComboBoxItem Content="White"/><ComboBoxItem Content="Custom"/></ComboBox><Button Grid.Column="2" Classes="secondaryAction" Content="Pick..." Click="PickGlowColorClicked" Margin="8,0,0,0"/></Grid>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Glow intensity (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="GlowIntensityBox" Grid.Column="1" Minimum="0" Maximum="100" Increment="5"/></Grid>
                <Grid ColumnDefinitions="245,210,110,*" Margin="6,0,0,0"><TextBlock Text="Main image background" VerticalAlignment="Center"/><ComboBox x:Name="MainBackgroundCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Follow theme"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Dark gray"/><ComboBoxItem Content="Neutral gray"/><ComboBoxItem Content="Light gray"/><ComboBoxItem Content="White"/><ComboBoxItem Content="Custom"/></ComboBox><Button Grid.Column="2" Classes="secondaryAction" Content="Pick..." Click="PickBackgroundColorClicked" Margin="8,0,0,0"/></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="appearance-zoom-fit" Title="Zoom and fit" Subtitle="How new images fit the window and how zoom behaves" Icon="Fit" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="260,210,*" Margin="6,0,0,0"><TextBlock Text="Default view for new images" VerticalAlignment="Center"/><ComboBox x:Name="DefaultViewCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Fit image"/><ComboBoxItem Content="Fit width"/><ComboBoxItem Content="Fit height"/><ComboBoxItem Content="Fit to window"/><ComboBoxItem Content="100%"/></ComboBox></Grid>
                <CheckBox x:Name="UpscaleSmallImagesCheck" Content="Allow upscale when fitting small images to window" ToolTip.Tip="When enabled, images smaller than the viewport will scale up to fill space in Fit Image / Fit Width / Fit Height modes."/>
                <CheckBox x:Name="PointerZoomCheck" Content="Zoom around mouse pointer"/>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Viewport zoom step (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="ViewportZoomStepBox" Grid.Column="1" Minimum="1" Maximum="100"/></Grid>
                <CheckBox x:Name="PreserveZoomCheck" Content="Preserve manual zoom while navigating"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="appearance-image-display" Title="Image display" Subtitle="Rendering quality, animated GIFs, scrollbars and loading feedback" Icon="Image" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="AnimateGifsCheck" Content="Play animated GIFs"/>
                <CheckBox x:Name="SubpixelRenderingCheck" Content="High-precision subpixel rendering for smooth zooming" ToolTip.Tip="Keeps image positioning and scaling silky smooth on fractional zoom levels."/>
                <CheckBox x:Name="ShowLoadingIndicatorCheck" Content="Show loading indicator during large image decoding"/>
                <CheckBox x:Name="ShowScrollbarsCheck" Content="Show slim scrollbars only when needed" ToolTip.Tip="Shows lightweight edge scrollbars only while a manually zoomed image exceeds the viewport."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="appearance-tooltips" Title="Tooltips" Subtitle="How long the pointer rests before a tooltip shows, per area, and the Explorer item info tip" Icon="Info" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="ExplorerItemInfoTooltipCheck" Content="Show info tooltip when hovering items in the Explorer tab" ToolTip.Tip="Resting the pointer on a file or folder in the Explorer tab shows its path, size and date."/>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Settings window delay (ms)" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown x:Name="TooltipDelaySettingsBox" Grid.Column="1" Minimum="0" Maximum="5000" Increment="100" FormatString="0" ToolTip.Tip="0 to 5000 ms; default 600, like Windows."/></Grid>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Main interface delay (ms)" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown x:Name="TooltipDelayMainBox" Grid.Column="1" Minimum="0" Maximum="5000" Increment="100" FormatString="0" ToolTip.Tip="Title bar, tabs, status bar and toolbar buttons. 0 to 5000 ms; default 600, like Windows."/></Grid>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Overlay mode delay (ms)" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown x:Name="TooltipDelayOverlayBox" Grid.Column="1" Minimum="0" Maximum="5000" Increment="100" FormatString="0" ToolTip.Tip="Controls while Glide runs in Overlay mode. 0 to 5000 ms; default 600."/></Grid>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Explorer tab items delay (ms)" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown x:Name="TooltipDelayExplorerBox" Grid.Column="1" Minimum="0" Maximum="5000" Increment="100" FormatString="0" ToolTip.Tip="Files and folders in the Explorer tab. 0 to 5000 ms; default 1500, about what Windows Explorer waits."/></Grid>
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard CardId="appearance-text-overlay" Title="Text overlay" Subtitle="The picture counter over the image and the folder position line under it" Icon="Info" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="PictureCounterCheck" Content="Show text overlay"/>
                <Grid ColumnDefinitions="205,330,*" Margin="6,0,0,0"><TextBlock Text="Text overlay template" VerticalAlignment="Center"/><TextBox x:Name="PictureTemplateBox" Grid.Column="1" Width="320" Text="[{index}/{total}]"/></Grid>
                <!-- Text and the template box tooltip come from code (TextOverlayTemplateHelp / Tip), where backslash-n cannot turn into a raw line break. -->
                <TextBlock x:Name="PictureTemplateHelpText" Classes="phaseNote" Margin="6,-2,8,2" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="245,220,*" Margin="6,0,0,0"><TextBlock Text="Text overlay position" VerticalAlignment="Center"/><ComboBox x:Name="PicturePositionCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Top left"/><ComboBoxItem Content="Top center"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Bottom center"/><ComboBoxItem Content="Bottom right"/></ComboBox></Grid>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Text overlay font size" VerticalAlignment="Center"/><NumericUpDown x:Name="PictureFontSizeBox" Grid.Column="1" Minimum="8" Maximum="48"/></Grid>
                <CheckBox x:Name="PictureBoldCheck" Content="Text overlay bold"/>
                <Grid ColumnDefinitions="245,220,*" Margin="6,0,0,0"><TextBlock Text="Text overlay colour" VerticalAlignment="Center"/><ComboBox x:Name="PictureColorCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="White"/><ComboBoxItem Content="Soft gray"/><ComboBoxItem Content="Accent"/><ComboBoxItem Content="Amber"/></ComboBox></Grid>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Text overlay opacity (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="PictureOpacityBox" Grid.Column="1" Minimum="10" Maximum="100"/></Grid>
                <CheckBox x:Name="PictureShadowCheck" Content="Text overlay shadow"/>
                <CheckBox x:Name="PictureBorderCheck" Content="Text overlay border" ToolTip.Tip="Encloses every line of the text overlay (the counter and the folder position line) in one box, styled like the Image information panel."/>
                <TextBlock Text="Folder position line" Classes="settingsSectionLabel" FontWeight="SemiBold" Margin="4,10,0,0"/>
                <CheckBox x:Name="ShowFolderCounterCheck" Content="Show folder position under image counter" ToolTip.Tip="Shows the current folder position and number of sibling folders."/>
                <CheckBox x:Name="FolderCounterGrandparentCheck" Content="Include parent folder position in folder counter" ToolTip.Tip="Adds the parent folder position within the grandparent, for example 5/50/4."/>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- WINDOW &amp; NAVIGATION (page key Interface) -->
          <StackPanel x:Name="InterfacePanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="window-window" Title="Window" Subtitle="Title, always on top, and window position and size" Icon="Maximize" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="FullPathTitleCheck" Content="Show full path in title"/>
                <CheckBox x:Name="AlwaysOnTopCheck" Content="Always keep Glide on top"/>
                <Grid ColumnDefinitions="205,250,*" Margin="6,0,0,0"><TextBlock Text="Always-on-top strength" VerticalAlignment="Center"/><ComboBox x:Name="AlwaysOnTopModeCombo" Grid.Column="1" Width="240" ToolTip.Tip="Soft applies HWND_TOPMOST normally. Hard also reasserts HWND_TOPMOST after competing Z-order changes, helping Glide stay above fullscreen windows."><ComboBoxItem Content="Soft"/><ComboBoxItem Content="Hard"/></ComboBox><TextBlock Grid.Column="2" Classes="phaseNote" Text="Soft applies HWND_TOPMOST normally; Hard also reasserts it after competing Z-order changes." VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
                <CheckBox x:Name="RememberPlacementCheck" Content="Remember window position, size and maximized state"/>
                <CheckBox x:Name="AutoCenterWindowOnRestoreCheck" Content="Auto-center window on screen when restoring from fullscreen / maximized" ToolTip.Tip="When restoring to a windowed state, position the window in the center of the active display."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-fullscreen" Title="Fullscreen" Subtitle="Title and tab bar, cursor hiding and what happens on exit" Icon="Fullscreen" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <!-- A link: the tooltip delays live on Appearance &amp; viewing > Tooltips. -->
                <Button x:Name="MainTooltipLinkButton" Click="TooltipDelayLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,8" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:GlideIconView Kind="Info" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="settingsCardTitle" Text="Tooltip delay →"/>
                      <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="How long title-bar, tab and status-bar tooltips wait. Opens Appearance &amp; viewing > Tooltips."/>
                    </StackPanel>
                  </Grid>
                </Button>
                <CheckBox x:Name="AutoHideFullscreenChromeCheck" Content="Auto-hide fullscreen title/tab bar"/>
                <CheckBox x:Name="FullscreenKeepTabBarOpenCheck" Content="Keep title/tab bar open in fullscreen (resizes image below it)"/>
                <CheckBox x:Name="FullscreenKeepTitleBarForExplorerCheck" Content="Keep title bar visible in full screen while Explorer is active" ToolTip.Tip="With an Explorer tab selected, the title/tab bar stays shown in fullscreen and the Explorer navigation row (Back, Forward, Up, address bar, filter) sits on its own line beneath it. Image and Welcome tabs keep the normal auto-hide."/>
                <CheckBox x:Name="HideCursorFullscreenCheck" Content="Hide cursor when idle in fullscreen"/>
                <Grid ColumnDefinitions="260,150,*" Margin="6,0,0,0"><TextBlock Text="Fullscreen cursor hide delay (seconds)" VerticalAlignment="Center"/><NumericUpDown x:Name="FullscreenHideCursorDelayBox" Grid.Column="1" Minimum="1" Maximum="30"/></Grid>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Behavior after exiting fullscreen" VerticalAlignment="Center"/><ComboBox x:Name="FullscreenExitBehaviorCombo" Grid.Column="1" Width="240"><ComboBoxItem Content="Restore size and location"/><ComboBoxItem Content="Maximized"/><ComboBoxItem Content="Minimized"/></ComboBox></Grid>
                <CheckBox x:Name="FullscreenXCloseCheck" IsVisible="False" IsEnabled="False"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-browsing-order" Title="Image order" Subtitle="The order of images in a folder and of sibling folders" Icon="Navigate" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Image order for next / previous" VerticalAlignment="Center"/><ComboBox x:Name="NavigationSortOrderCombo" Grid.Column="1" Width="240" ToolTip.Tip="How the images of a folder are ordered when you go to the next or previous image. Name (like Explorer) is the default and matches Windows Explorer, with numbers in natural order."><ComboBoxItem Content="Name (like Explorer)"/><ComboBoxItem Content="Name (plain characters)"/><ComboBoxItem Content="Type"/><ComboBoxItem Content="Size"/><ComboBoxItem Content="Date modified"/><ComboBoxItem Content="Date created"/></ComboBox></Grid>
                <CheckBox x:Name="NavigationSortDescendingCheck" Content="Reverse the image order (descending)" ToolTip.Tip="Walk the folder in the opposite direction: Z to A, largest to smallest, newest to oldest."/>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0">
                  <TextBlock Text="Sibling-folder order" VerticalAlignment="Center"/>
                  <ComboBox x:Name="FolderNavOrderCombo" Grid.Column="1" Width="240" SelectedIndex="0">
                    <ComboBoxItem Content="Alphabetical"/>
                    <ComboBoxItem Content="Modified date (oldest first)"/>
                    <ComboBoxItem Content="Creation date (oldest first)"/>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Classes="phaseNote" Text="Default: alphabetical. Date modes use oldest first, then a stable name tie-breaker." VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-folders" Title="Moving between folders" Subtitle="What next / previous does at the end of a folder" Icon="FolderNext" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="300,300,*">
                  <TextBlock Text="When the last image is reached" VerticalAlignment="Center"/>
                  <ComboBox x:Name="EndOfFolderActionCombo" Grid.Column="1" Width="290" ToolTip.Tip="What Next does at the last image of a folder. Previous at the first image does the same in the other direction (&quot;next&quot; is the folder in the direction you are moving).">
                    <ComboBoxItem Content="Do nothing"/>
                    <ComboBoxItem Content="Loop this folder"/>
                    <ComboBoxItem Content="Move to the next folder"/>
                    <ComboBoxItem Content="Move to the next folder in a new tab"/>
                    <ComboBoxItem Content="Go back to the previous folder"/>
                    <ComboBoxItem Content="Show Home"/>
                    <ComboBoxItem Content="Ask me each time"/>
                  </ComboBox>
                </Grid>
                <TextBlock Classes="phaseNote" Text="Default: ask me each time." Margin="0,-4,0,0"/>
                <Border x:Name="EndOfFolderFolderOptions" BorderBrush="#40FFFFFF" BorderThickness="1,0,0,0" Padding="14,2,0,2" Margin="8,0,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Folder options" FontWeight="SemiBold" Opacity="0.85"/>
                    <CheckBox x:Name="HierarchicalFolderTraversalCheck" Content="Continue into nearby parent/grandparent folder branches" ToolTip.Tip="When the current sibling set ends, continue into the next nearby branch. Enabled by default."/>
                    <CheckBox x:Name="ConfirmHierarchicalFolderTraversalCheck" Content="Confirm before leaving the current folder branch" ToolTip.Tip="The first ancestor-boundary transition asks before continuing; the prompt can be disabled permanently."/>
                    <Grid ColumnDefinitions="300,220,*" Margin="6,0,0,0">
                      <TextBlock Text="Previous into parent/grandparent branch" VerticalAlignment="Center"/>
                      <ComboBox x:Name="HierarchicalPreviousFolderEntryCombo" Grid.Column="1" Width="210">
                        <ComboBoxItem Content="First image"/>
                        <ComboBoxItem Content="Last image"/>
                      </ComboBox>
                      <TextBlock Grid.Column="2" Classes="phaseNote" Text="Default: first image." VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="FolderNavFirstImageCheck" Content="Open the first image when entering a sibling folder (off: the last image)"/>
                    <CheckBox x:Name="FolderNavWrapCheck" Content="Wrap sibling-folder navigation at parent-directory ends"/>
                    <CheckBox x:Name="FolderNavSkipEmptyCheck" Content="Skip sibling folders that contain no supported images"/>
                    <CheckBox x:Name="FolderNavIncludeHiddenCheck" Content="Include hidden sibling folders" ToolTip.Tip="Off by default. When disabled, folders marked Hidden (and dot-prefixed folders) are excluded from sibling navigation."/>
                  </StackPanel>
                </Border>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-title-bar" Title="Title bar buttons" Subtitle="Utility buttons and the folder navigation buttons" Icon="Interface" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Button x:Name="CustomizeTitleBarButton" Classes="secondaryAction" Content="Customize title-bar buttons..." Click="CustomizeTitleBarClicked" HorizontalAlignment="Left" MinWidth="230"/>
                <CheckBox x:Name="FolderNavGroupCheck" Content="Show sibling-folder navigation group on title bar"/>
                <CheckBox x:Name="FolderNavPreviousCheck" Content="Show Previous Folder button"/>
                <CheckBox x:Name="FolderNavNextCheck" Content="Show Next Folder button"/>
                <CheckBox x:Name="TabBarBackButtonCheck" IsVisible="False" Content="Show Up / return-to-folder button in right-side title navigation"/>
                <CheckBox x:Name="TabBarForwardButtonCheck" IsVisible="False" Content="Show Forward button in right-side title navigation"/>
                <CheckBox x:Name="FolderNavExploreCheck" Content="Show Explore Parent Folders button" IsVisible="False"/>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0">
                  <TextBlock Text="Show in Explorer button opens" VerticalAlignment="Center"/>
                  <ComboBox x:Name="ShowInExplorerTargetCombo" Grid.Column="1" Width="240" ToolTip.Tip="What the title-bar Show in File Explorer button does. You can also right-click that button to switch.">
                    <ComboBoxItem Content="Glide's Explorer tab"/>
                    <ComboBoxItem Content="Windows File Explorer"/>
                    <ComboBoxItem Content="Alternative file manager"/>
                  </ComboBox>
                </Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-rate-limit" Title="Navigation speed limit" Subtitle="Slow down next / previous when keys or the wheel repeat too fast" Icon="Pause" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="300,170,*" Margin="6,0,0,0">
                  <TextBlock Text="Minimum interval between actions (ms)" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="NavigationRateLimitMsBox" Grid.Column="1" Minimum="0" Maximum="600000" Increment="1"/>
                  <TextBlock Grid.Column="2" Classes="phaseNote" Text="0 = unlimited. Default: 120 ms. Any millisecond value may be used." VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="NavigationRateLimitHelpText" Classes="phaseNote" Text="Raise this if one key press skips several pictures (common on laptop keyboards). Lower it for faster browsing. 0 = no limit." TextWrapping="Wrap" Margin="6,-4,8,2"/>
                <CheckBox x:Name="NavigationSkipHintCheck" Content="Tell me when a key press seems to skip pictures" Margin="6,0,0,0"
                          ToolTip.Tip="Shows a small hint (at most once every 5 minutes) when one press of a next / previous key seems to skip several pictures."/>
                <Grid ColumnDefinitions="300,220,*" Margin="6,0,0,0">
                  <TextBlock Text="Apply limit to" VerticalAlignment="Center"/>
                  <ComboBox x:Name="NavigationRateLimitInputCombo" Grid.Column="1" Width="210">
                    <ComboBoxItem Content="Mouse only"/>
                    <ComboBoxItem Content="Keyboard only"/>
                    <ComboBoxItem Content="Both"/>
                  </ComboBox>
                </Grid>
                <WrapPanel ItemSpacing="16" LineSpacing="8" Margin="6,0,0,0">
                  <TextBlock Text="Limit in:" VerticalAlignment="Center"/>
                  <CheckBox x:Name="NavigationRateLimitWindowedCheck" Content="Windowed"/>
                  <CheckBox x:Name="NavigationRateLimitFullscreenCheck" Content="Fullscreen"/>
                  <CheckBox x:Name="NavigationRateLimitSlideshowCheck" Content="Slideshow"/>
                </WrapPanel>
                <CheckBox x:Name="NavigationRateLimitIndicatorCheck" Content="Show rate-limit wait indicator when an action is blocked"/>
                <Grid ColumnDefinitions="300,220,*" Margin="6,0,0,0">
                  <TextBlock Text="Rate-limit wait indicator position" VerticalAlignment="Center"/>
                  <ComboBox x:Name="NavigationRateLimitIndicatorPositionCombo" Grid.Column="1" Width="210">
                    <ComboBoxItem Content="Top left"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Bottom right"/><ComboBoxItem Content="Centre"/>
                  </ComboBox>
                </Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="window-explorer" Title="Explorer tab" Subtitle="The view and which files Glide's own Explorer tab lists" Icon="Browser" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Explorer default view" VerticalAlignment="Center"/>
                  <!-- Items come from the Explorer tab's own view labels (PopulateExplorerDefaultViewCombo). -->
                  <ComboBox x:Name="ExplorerDefaultViewCombo" Grid.Column="1" Width="220"/>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Open a picture's folder in" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="ExplorerLocateOpensInCombo" Grid.Column="1" Width="220" ToolTip.Tip="Where Ctrl+E (Show in Explorer tab, Open file location) shows the picture's folder. Same tab: Back returns to the picture in that tab.">
                    <ComboBoxItem Content="Same tab"/>
                    <ComboBoxItem Content="Existing or new tab"/>
                    <ComboBoxItem Content="Always a new tab"/>
                    <ComboBoxItem Content="New window"/>
                  </ComboBox>
                </Grid>
                <Grid x:Name="ExplorerBackReturnsToImageRow" ColumnDefinitions="260,230,*" Margin="6,0,0,0" ToolTip.Tip="Only used when a picture's folder opens in another tab or window. With Same tab, Back is the tab's own history.">
                  <TextBlock Text="Back after opening a picture's folder" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="ExplorerBackReturnsToImageCombo" Grid.Column="1" Width="220">
                    <ComboBoxItem Content="Folders, then back to the picture"/>
                    <ComboBoxItem Content="Straight back to the picture"/>
                    <ComboBoxItem Content="Folders only"/>
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="ExplorerShowHiddenFilesCheck" Content="Show hidden files in Explorer tab"/>
                <CheckBox x:Name="ExplorerClickToRenameCheck" Content="Click a selected item's name to rename it" ToolTip.Tip="On (default): click the name of the one selected item again, slowly (not a double-click), to rename it, as in Windows File Explorer. F2 and the Rename menu item always work."/>
                <CheckBox x:Name="ExplorerKeepSelectionInViewCheck" Content="Keep selection in view when sorting" ToolTip.Tip="Off (default): changing the sort keeps the list where it was. On: the list scrolls to the selected item. Also in the Sort menu."/>
                <CheckBox x:Name="AddressBarOverPicturesCheck" Content="Show address bar while viewing pictures" ToolTip.Tip="The Explorer tab's Back, Forward, Recent, Up, Refresh and address bar also show above pictures, with the picture's folder. Hidden in fullscreen and Overlay mode. Also on the row's right-click menu."/>
                <CheckBox x:Name="ExplorerShowOnlyImagesCheck" Content="Explorer tab lists only folders and images (off: every file type)"/>
                <StackPanel x:Name="ExplorerThumbnailInfoRow" Orientation="Horizontal" Spacing="16" Margin="6,0,0,0" ToolTip.Tip="Extra lines under each thumbnail in the Extra large, Large and Medium views. All off by default; tiles grow by one line for each item shown.">
                  <TextBlock Text="Show under thumbnails:" VerticalAlignment="Center"/>
                  <CheckBox x:Name="ExplorerInfoDateCheck" Content="Date"/>
                  <CheckBox x:Name="ExplorerInfoResolutionCheck" Content="Resolution"/>
                  <CheckBox x:Name="ExplorerInfoFileSizeCheck" Content="File size"/>
                </StackPanel>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Drive bar width (px)" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="ExplorerNavPaneWidthBox" Grid.Column="1" Width="220" Minimum="120" Maximum="600" Increment="10" FormatString="0" ToolTip.Tip="Width of the Explorer tab's drive bar (120 to 600, default 208). You can also drag the line between the drive bar and the thumbnails."/>
                </Grid>
                <!-- Mouse-wheel scrolling: one group so "Explorer scroll speed and amount" on Mouse & keyboard reveals and highlights all of it. -->
                <StackPanel x:Name="ExplorerScrollSettingsGroup" Spacing="10">
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Explorer scroll amount" VerticalAlignment="Center"/>
                  <ComboBox x:Name="ExplorerScrollModeCombo" Grid.Column="1" Width="220" ToolTip.Tip="How far one mouse-wheel notch scrolls. Rows move by the current view's row height.">
                    <ComboBoxItem Content="One row per notch"/>
                    <ComboBoxItem Content="Rows per notch (fixed)"/>
                    <ComboBoxItem Content="Per view (1 / 2 / 3)"/>
                    <ComboBoxItem Content="Pixels per notch"/>
                  </ComboBox>
                </Grid>
                <Grid x:Name="ExplorerScrollRowsRow" ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Rows per notch" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="ExplorerScrollRowsBox" Grid.Column="1" Width="220" Minimum="1" Maximum="20" Increment="1" FormatString="0" ToolTip.Tip="Used when Explorer scroll amount is Rows per notch (fixed)."/>
                </Grid>
                <Grid x:Name="ExplorerScrollPixelsRow" ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Pixels per notch" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="ExplorerScrollPixelsBox" Grid.Column="1" Width="220" Minimum="10" Maximum="1000" Increment="10" FormatString="0" ToolTip.Tip="Used when Explorer scroll amount is Pixels per notch; ignores row size."/>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Explorer scroll speed (x)" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="ExplorerScrollSpeedBox" Grid.Column="1" Width="220" Minimum="0.25" Maximum="4" Increment="0.25" FormatString="0.##" ToolTip.Tip="Wheel speed multiplier applied on top of the Explorer scroll amount, in every mode."/>
                </Grid>
                </StackPanel>
                <Grid ColumnDefinitions="260,*,Auto,Auto" ColumnSpacing="7" Margin="6,0,0,0">
                  <TextBlock Text="Alternative file manager (.exe)" VerticalAlignment="Center"/>
                  <TextBox x:Name="AlternativeFileManagerPathBox" Grid.Column="1" Watermark="Empty: none" ToolTip.Tip="Offered in the right-click menu of the Show in File Explorer buttons (title bar and Explorer toolbar)."/>
                  <Button x:Name="AlternativeFileManagerBrowseButton" Grid.Column="2" Classes="secondaryAction" Content="Browse…" Click="BrowseAlternativeFileManagerClicked" ToolTip.Tip="Choose a file manager program (.exe)"/>
                  <Button x:Name="AlternativeFileManagerClearButton" Grid.Column="3" Classes="secondaryAction" MinWidth="0" Padding="10,4" Content="✕" Click="ClearAlternativeFileManagerClicked" ToolTip.Tip="Clear: no alternative file manager"/>
                </Grid>
                <Grid ColumnDefinitions="260,*" Margin="6,0,0,0">
                  <TextBlock Text="Alternative file manager arguments" VerticalAlignment="Center"/>
                  <TextBox x:Name="AlternativeFileManagerArgumentsBox" Grid.Column="1" ToolTip.Tip="{}{path} is replaced with the selected file, or the folder when nothing is selected."/>
                </Grid>
                <!-- A link: the tooltip delays live on Appearance &amp; viewing > Tooltips. -->
                <Button x:Name="ExplorerTooltipLinkButton" Click="TooltipDelayLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,8" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:GlideIconView Kind="Info" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="settingsCardTitle" Text="Tooltip delay →"/>
                      <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="Explorer items, and turning their info tooltip off. Opens Appearance &amp; viewing > Tooltips."/>
                    </StackPanel>
                  </Grid>
                </Button>
                <!-- A link, not a copy: how pictures open in new tabs lives on Tabs & status bar > Tabs (NewTabSettingsGroup). -->
                <Button x:Name="NewTabsLinkButton" Click="NewTabsLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,8" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:GlideIconView Kind="Tabs" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="settingsCardTitle" Text="Opening pictures in new tabs →"/>
                      <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="Foreground or background, position, and the key to open the other way. Opens Tabs &amp; status bar > Tabs."/>
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
            </controls:SettingsCard>
          </StackPanel>

          <!-- TABS &amp; STATUS BAR -->
          <StackPanel x:Name="TabsPanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="tabs-tabs" Title="Tabs" Subtitle="Turning tabs on, opening, switching, closing, hover previews and closed-tab history" Icon="Tabs" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="TabsCheck" Content="Enable tabs"/>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Ctrl+Tab switching order" VerticalAlignment="Center"/>
                  <ComboBox x:Name="TabCycleOrderCombo" Grid.Column="1" Width="220">
                    <ComboBoxItem Content="Tab order"/>
                    <ComboBoxItem Content="Most recently used"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="When the last tab is closed" VerticalAlignment="Center"/>
                  <ComboBox x:Name="LastTabBehaviorCombo" Grid.Column="1" Width="220">
                    <ComboBoxItem Content="Open home page"/>
                    <ComboBoxItem Content="Keep last tab open"/>
                    <ComboBoxItem Content="Close program"/>
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="ConfirmCloseMultipleTabsCheck" Content="Ask before closing a Glide window that contains multiple image tabs"/>
                <Grid ColumnDefinitions="225,150,*" Margin="6,0,0,0"><TextBlock Text="Recently closed tabs retained" VerticalAlignment="Center"/><NumericUpDown x:Name="ClosedHistoryBox" Grid.Column="1" Minimum="1" Maximum="100"/></Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="After closing a tab, activate" VerticalAlignment="Center"/>
                  <ComboBox x:Name="AfterTabCloseActivateCombo" Grid.Column="1" Width="220" ToolTip.Tip="Previously used tab (default): the tab you were on before. Match Ctrl+Tab order: the previously used tab when Ctrl+Tab switching order is Most recently used, otherwise the tab to the right. Or the tab to the right / left, the first or the last tab. Custom: a new tab of the kind chosen below takes the closed tab's place.">
                    <ComboBoxItem Content="Match Ctrl+Tab order"/>
                    <ComboBoxItem Content="Previously used tab"/>
                    <ComboBoxItem Content="Tab to the right"/>
                    <ComboBoxItem Content="Tab to the left"/>
                    <ComboBoxItem Content="First tab"/>
                    <ComboBoxItem Content="Last tab"/>
                    <ComboBoxItem Content="Custom…"/>
                  </ComboBox>
                </Grid>
                <Grid x:Name="AfterTabCloseCustomRow" ColumnDefinitions="242,300,*" Margin="24,0,0,0">
                  <TextBlock Text="Custom tab to show" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="AfterTabCloseCustomTargetCombo" Grid.Column="1" Width="290" ToolTip.Tip="After closing a tab, a new tab of this kind takes its place: Home (default), a new empty Explorer tab at the last Explorer folder, or an Explorer tab with the closed picture's folder. If that is not possible, the previously used tab comes to the front.">
                    <ComboBoxItem Content="Home"/>
                    <ComboBoxItem Content="New empty Explorer tab"/>
                    <ComboBoxItem Content="Explorer tab with the closed picture's folder"/>
                  </ComboBox>
                </Grid>
                <!-- How a picture or folder opens in a new tab: one group so the Explorer tab card's "Opening pictures in new tabs" link reveals and highlights all of it. -->
                <StackPanel x:Name="NewTabSettingsGroup" Spacing="10">
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="New tabs open" VerticalAlignment="Center"/>
                  <ComboBox x:Name="NewTabPositionCombo" Grid.Column="1" Width="220" ToolTip.Tip="For pictures and folders opened in a new tab from inside Glide. Ctrl+T and + always open at the end, like a web browser.">
                    <ComboBoxItem Content="at the end"/>
                    <ComboBoxItem Content="next to the current tab"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="242,230,*" Margin="24,0,0,0">
                  <TextBlock x:Name="NewTabPositionKeyLabel" Text="Key to open at the end instead" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="NewTabPositionKeyCombo" Grid.Column="1" Width="140" ToolTip.Tip="Hold this key while opening a picture or folder in a new tab to put that one tab at the other position. None turns it off. Ctrl+T and + are not affected."><ComboBoxItem Content="None"/><ComboBoxItem Content="Shift"/><ComboBoxItem Content="Ctrl"/><ComboBoxItem Content="Alt"/></ComboBox>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Open new tabs in the" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SwitchToNewTabsCombo" Grid.Column="1" Width="220" ToolTip.Tip="Foreground (default): Glide switches to a picture or folder you open in a new tab. Background: it opens behind the current tab. Ctrl+T and + always switch.">
                    <ComboBoxItem Content="foreground"/>
                    <ComboBoxItem Content="background"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="242,230,*" Margin="24,0,0,0">
                  <TextBlock x:Name="NewTabForegroundKeyLabel" Text="Key to open in the background instead" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="NewTabForegroundKeyCombo" Grid.Column="1" Width="140" ToolTip.Tip="Hold this key while opening a picture or folder in a new tab to do the other of foreground and background for that one tab. None turns it off. Ctrl+T and + are not affected."><ComboBoxItem Content="None"/><ComboBoxItem Content="Shift"/><ComboBoxItem Content="Ctrl"/><ComboBoxItem Content="Alt"/></ComboBox>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Middle-click opens in a new tab in the" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="MiddleClickSideCombo" Grid.Column="1" Width="220" ToolTip.Tip="Explorer middle-click on a picture or folder: open it in a background tab (default, like a web browser) or in the foreground. The keys above still flip it for one tab.">
                    <ComboBoxItem Content="background"/>
                    <ComboBoxItem Content="foreground"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Middle-click new tab position" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <ComboBox x:Name="MiddleClickPositionCombo" Grid.Column="1" Width="220" ToolTip.Tip="Where an Explorer middle-click puts the new tab: at the end (default), next to the current tab, or the same as New tabs open.">
                    <ComboBoxItem Content="at the end"/>
                    <ComboBoxItem Content="next to the current tab"/>
                    <ComboBoxItem Content="same as new tabs"/>
                  </ComboBox>
                </Grid>
                </StackPanel>
                <CheckBox x:Name="TabHoverPreviewsCheck" Content="Show tab previews on hover" ToolTip.Tip="Hovering a background tab shows a small preview of its picture or folder in the tab tooltip."/>
                <CheckBox x:Name="AnimateGifPreviewsCheck" Content="Animate GIF previews on hover" Margin="24,0,0,0" IsEnabled="{Binding #TabHoverPreviewsCheck.IsChecked}" ToolTip.Tip="An animated GIF tab's hover preview plays while the tooltip is open. Very large GIFs keep the still first frame. Needs Show tab previews on hover."/>
                <Grid ColumnDefinitions="231,140,*" Margin="24,0,0,0" IsEnabled="{Binding #TabHoverPreviewsCheck.IsChecked}"><TextBlock Text="Tab preview size (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="TabPreviewSizeBox" Grid.Column="1" Minimum="50" Maximum="250" Increment="10" FormatString="0" ToolTip.Tip="50 to 250 percent of the normal preview size (100). Also: hold the Resize preview key and turn the wheel over a tab while its preview shows."/></Grid>
                <Grid ColumnDefinitions="231,140,*" Margin="24,0,0,0" IsEnabled="{Binding #TabHoverPreviewsCheck.IsChecked}"><TextBlock Text="Resize preview with wheel and" VerticalAlignment="Center"/><ComboBox x:Name="TabPreviewResizeModifierCombo" Grid.Column="1" Width="140" ToolTip.Tip="Hold this key and turn the mouse wheel over a tab to resize its open preview. None turns it off."><ComboBoxItem Content="Ctrl"/><ComboBoxItem Content="Shift"/><ComboBoxItem Content="Alt"/><ComboBoxItem Content="None"/></ComboBox></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-strip-look" Title="Tab strip look" Subtitle="Tab widths, overflow arrows and tooltip size" Icon="Tabs" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Minimum tab width" VerticalAlignment="Center"/><NumericUpDown x:Name="TabMinWidthBox" Grid.Column="1" Minimum="80" Maximum="240"/></Grid>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Maximum tab width" VerticalAlignment="Center"/><NumericUpDown x:Name="TabMaxWidthBox" Grid.Column="1" Minimum="120" Maximum="400"/></Grid>
                <CheckBox x:Name="TabOverflowArrowsCheck" Content="Show left/right navigation arrows when tabs overflow" ToolTip.Tip="Theme-coloured tab-shaped arrows appear only when there are hidden tabs in that direction."/>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Tab tooltip text size" VerticalAlignment="Center"/>
                  <ComboBox x:Name="TabToolTipTextSizeCombo" Grid.Column="1" Width="220">
                    <ComboBoxItem Content="Small"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Large"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="260,230,*" Margin="6,0,0,0">
                  <TextBlock Text="Tab position" VerticalAlignment="Center"/>
                  <ComboBox x:Name="TabPositionCombo" Grid.Column="1" Width="220" ToolTip.Tip="Top: tabs along the title bar. Side: a vertical tab panel on the left.">
                    <ComboBoxItem Content="Top"/>
                    <ComboBoxItem Content="Side"/>
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="TabSideAutoHideCheck" Content="Auto-hide the side tab panel (it slides in at the left edge of the window)"/>
                <CheckBox x:Name="TabTopAutoHideCheck" Content="Auto-hide the top tab strip (it appears at the top edge)"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-detach" Title="Moving tabs between windows" Subtitle="Drag tabs out into new windows or onto another window" Icon="Move" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="TabDetachCheck" Content="Allow dragging tabs out into new Glide windows" ToolTip.Tip="Drag a tab outside the strip and release to create a new Glide window."/>
                <CheckBox x:Name="TabAttachCheck" Content="Allow dragging tabs between Glide windows" ToolTip.Tip="Drag a tab over another Glide tab strip and release to rejoin it."/>
                <CheckBox x:Name="CloseEmptyAfterDetachCheck" Content="Close source window if its final tab is detached"/>
                <CheckBox x:Name="DetachedHomeTabCheck" Content="Include a Home tab in newly detached windows"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-status-bar" Title="Status bar" Subtitle="When the status bar shows, hides and collapses" Icon="Status" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="StatusCheck" Content="Show status bar"/>
                <CheckBox x:Name="StatusAutoHideCheck" Content="Auto-hide the status bar (it appears when the pointer enters the area where the bar shows)" ToolTip.Tip="Works like Windows' taskbar auto-hide: the bar is fully hidden until the pointer enters the invisible reveal zone at the bottom of the window (size below), and hides again shortly after the pointer leaves the bar. It never hides while the pointer is over the bar or its menus."/>
                <CheckBox x:Name="StatusHoverWhenClosedCheck" Content="Reveal the collapsed status bar when the pointer enters where it would appear" ToolTip.Tip="On by default. The invisible reveal area is exactly the box the status bar occupies when shown (a thin strip in a wide window, a taller box when the bar wraps into several rows); adjust it below."/>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Reveal area adjustment (DIP)" VerticalAlignment="Center"/><NumericUpDown x:Name="StatusRevealZoneExpandBox" Grid.Column="1" Minimum="-40" Maximum="300" Increment="5" FormatString="0" ToolTip.Tip="Fine-tunes the invisible area that reveals a collapsed or auto-hidden status bar. 0 (default) is exactly the size of the status bar's own box. Positive values grow the area outward on every side, negative values shrink it inward (never below 6 DIP tall and 40 DIP wide). It is not drawn and never blocks clicks or drags on the image."/></Grid>
                <CheckBox x:Name="StatusCollapsedCornerCheck" Content="Park collapsed status button in the lower-right corner"/>
                <CheckBox x:Name="FullscreenStatusAlwaysCheck" Content="Keep status bar visible in fullscreen"/>
                <CheckBox x:Name="StatusReserveFitSpaceCheck" Content="Reserve status bar space when fitting (image fits above the bar instead of under it)"/>
                <CheckBox x:Name="StatusStackInfoLineCheck" Content="Always stack the information on a separate line (file info above the buttons, even in a wide window)" ToolTip.Tip="On by default: the file name, position, size and zoom always sit on their own line at the top of the status bar, with the minimise and close buttons at its right and the button groups on the row below. Off: in a wide window everything shares a single line and the bar only wraps when the window is narrow."/>
                <CheckBox x:Name="StatusGifOnlyOnGifsCheck" Content="Show GIF controls only on GIFs" ToolTip.Tip="Off (default): the GIF play / pause and frame buttons always sit in the status bar and are greyed out on images that are not animated GIFs. On: they appear only while an animated GIF is open."/>
                <CheckBox x:Name="StatusFileNameClickActionsCheck" Content="Click the file name to rename it, double-click to open its location" ToolTip.Tip="Off by default. On: a single click on the file name in the status bar starts Rename; a double-click opens the folder in Windows Explorer with the file selected."/>
                <Button x:Name="CustomizeStatusBarButton" Classes="secondaryAction" Content="Customize status-bar buttons..." Click="CustomizeStatusBarClicked" HorizontalAlignment="Left" MinWidth="230"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-status-buttons" Title="Status bar buttons" Subtitle="Which controls the status bar offers" Icon="More" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="StatusNavigationCheck" Content="Show navigation controls"/>
                <CheckBox x:Name="StatusZoomCheck" Content="Show zoom controls"/>
                <CheckBox x:Name="StatusSlideshowCheck" Content="Show slideshow control"/>
                <CheckBox x:Name="StatusFitCheck" Content="Show Fit image / Fit width / Fit height controls"/>
                <Grid ColumnDefinitions="245,290,*" Margin="6,0,0,0"><TextBlock Text="Fit control scope" VerticalAlignment="Center"/><ComboBox x:Name="StatusFitScopeCombo" Grid.Column="1" Width="280" ToolTip.Tip="Choose what the Fit / Fit to window / Fit width / Fit height / 100% commands change, whether from the status bar buttons, hotkeys, menus or gestures: only the current image, every image this session, or this session and future launches (default)."><ComboBoxItem Content="Only the current image"/><ComboBoxItem Content="This session"/><ComboBoxItem Content="This session and future sessions"/></ComboBox></Grid>
                <CheckBox x:Name="StatusInfoCheck" Content="Show image information control"/>
                <CheckBox x:Name="StatusOptionsCheck" Content="Show options menu"/>
                <CheckBox x:Name="StatusCloseCheck" Content="Show close control"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-status-info" Title="Status bar information" Subtitle="Which image details the status bar shows" Icon="Info" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <WrapPanel Margin="0,2,0,0"><CheckBox x:Name="StatFileNameCheck" Content="File name" Margin="0,0,24,6"/><CheckBox x:Name="StatIndexCheck" Content="Index" Margin="0,0,24,6"/><CheckBox x:Name="StatResolutionCheck" Content="Resolution" Margin="0,0,24,6"/><CheckBox x:Name="StatZoomCheck" Content="Zoom" Margin="0,0,24,6"/><CheckBox x:Name="StatFileSizeCheck" Content="File size" Margin="0,0,24,6"/><CheckBox x:Name="StatFormatCheck" Content="Format" Margin="0,0,24,6"/></WrapPanel>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="tabs-status-look" Title="Status bar look" Subtitle="Size, position and scaling of the status bar" Icon="Appearance" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="245,210,*" Margin="6,0,0,0"><TextBlock Text="Status bar size" VerticalAlignment="Center"/><ComboBox x:Name="StatusBarSizeCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Tiny"/><ComboBoxItem Content="Very small"/><ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/><ComboBoxItem Content="Extra large"/></ComboBox></Grid>
                <Grid ColumnDefinitions="245,210,*" Margin="6,0,0,0"><TextBlock Text="Status bar position" VerticalAlignment="Center"/><ComboBox x:Name="StatusBarAlignmentCombo" Grid.Column="1" Width="210"><ComboBoxItem Content="Center"/><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/></ComboBox></Grid>
                <CheckBox x:Name="StatusAutoFitCheck" Content="Auto-resize status bar (shrink buttons to fit narrow windows)"/>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Global status-bar scale (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="StatusGlobalScaleBox" Grid.Column="1" Minimum="60" Maximum="160" Increment="5" ToolTip.Tip="100% is the default scale applied across all named status-bar sizes."/></Grid>
                <Grid ColumnDefinitions="245,150,*" Margin="6,0,0,0"><TextBlock Text="Maximized/fullscreen size boost (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="StatusMaximizedBoostBox" Grid.Column="1" Minimum="0" Maximum="30" Increment="5"/></Grid>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- MOUSE &amp; KEYBOARD -->
          <StackPanel x:Name="MousePanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="mouse-gestures" Title="Mouse gestures" Subtitle="What each click, drag and wheel does in every area" Icon="Mouse" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Classes="phaseNote" Margin="4,0,8,2" Text="Pick an area, then choose what each click, drag and wheel does there. Default (...) shows what Glide does when a row is unchanged; changed rows are outlined in the accent colour."/>
                <Border x:Name="GestureMatrixHost" Classes="gestureCard" controls:SettingsCard.SettingIds="mouse.gestureMatrix"/>
                <!-- Secondary options that modify a gesture row rather than replace it. BuildGestureMatrix moves
                     each into its area pane (Tag = gestureArea:<area id>); until then they stay here. -->
                <StackPanel x:Name="GestureSecondaryOptionsHost" Spacing="8">
                  <CheckBox Tag="gestureArea:windowed" x:Name="InvertWheelCheck" Content="Reverse mouse-wheel direction (scroll down = next, scroll up = previous by default)"/>
                  <Grid Tag="gestureArea:windowed" ColumnDefinitions="205,300,*" Margin="6,0,0,0"><TextBlock Text="Left-drag window behavior" VerticalAlignment="Center"/><ComboBox x:Name="LeftWindowDragBehaviorCombo" Grid.Column="1" Width="300" ToolTip.Tip="Smart (default): a left-drag may move a normal/restored window but never drags a maximized or fullscreen window. Never move window blocks left-drag window movement. Allow when maximized preserves the older restore-and-drag behavior from a maximized window."><ComboBoxItem Content="Smart (normal window only)"/><ComboBoxItem Content="Never move window"/><ComboBoxItem Content="Allow move when maximized"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:windowed" ColumnDefinitions="205,300,*" Margin="6,0,0,0"><TextBlock Text="Right-drag behavior" VerticalAlignment="Center"/><ComboBox x:Name="RightDragBehaviorCombo" Grid.Column="1" Width="300" ToolTip.Tip="Smart: pan only when the image is cropped/zoomed; otherwise move a normal window. Maximized/fullscreen does nothing unless the image can be panned."><ComboBoxItem Content="Smart (pan image / move window)"/><ComboBoxItem Content="Pan image only"/><ComboBoxItem Content="Move window"/><ComboBoxItem Content="Do nothing"/></ComboBox></Grid>
                  <CheckBox Tag="gestureArea:background" x:Name="BackgroundDragCheck" Content="Left-drag empty background moves the native window"/>
                  <CheckBox Tag="gestureArea:selection" x:Name="SelectionBufferCheck" Content="Selection buffer: start a selection from the empty area around the picture" ToolTip.Tip="Pressing in the empty (black) area just outside a picture starts a selection that is still clamped to the picture's pixels, so you can begin right at the edge of a small image. Beyond the buffer the empty area still drags the window. Applies when left-drag is set to create a selection."/>
                  <CheckBox Tag="gestureArea:selection" x:Name="SelectionBufferAllModesCheck" Content="Use the maximized buffer size in every window state" ToolTip.Tip="Fully enable the buffer in all modes: the maximized size (normally the whole empty area) is also used in a normal window. Fullscreen keeps its own click handling."/>
                  <Grid Tag="gestureArea:selection" ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Selection buffer size - windowed (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="SelectionBufferWindowedBox" Grid.Column="1" Minimum="0" Maximum="100" ToolTip.Tip="Share of the empty space on each side of the picture that counts as selection buffer in a normal (non-maximized) window. 33 is about one third; 100 is the whole empty area; 0 turns it off while windowed."/></Grid>
                  <Grid Tag="gestureArea:selection" ColumnDefinitions="270,150,*" Margin="6,0,0,0"><TextBlock Text="Selection buffer size - maximized (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="SelectionBufferMaximizedBox" Grid.Column="1" Minimum="0" Maximum="100" ToolTip.Tip="Share of the empty space on each side of the picture that counts as selection buffer when the window is maximized. 100 makes the entire empty area a buffer; 0 turns it off while maximized."/></Grid>
                  <CheckBox Tag="gestureArea:selection" x:Name="ReverseSelectionZoomOutScaleCheck" Content="Reverse selection-to-zoom-out scale (smaller selection = larger zoom out)" ToolTip.Tip="Default is on: smaller selections zoom farther out. Disable to restore the direct selection-size mapping."/>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Minimize button (windowed)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionWindowedMinimizeCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Maximize button (windowed)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionWindowedMaximizeCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Close button (windowed)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionWindowedCloseCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Minimize button (fullscreen)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionFullscreenMinimizeCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Maximize button (fullscreen)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionFullscreenMaximizeCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                  <Grid Tag="gestureArea:titleBar" ColumnDefinitions="250,310,*" Margin="6,0,0,0"><TextBlock Text="Close button (fullscreen)" VerticalAlignment="Center"/><ComboBox x:Name="CaptionFullscreenCloseCombo" Grid.Column="1" Width="300"><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Maximize / restore"/><ComboBoxItem Content="Close Glide"/><ComboBoxItem Content="Enter fullscreen"/><ComboBoxItem Content="Exit fullscreen (restore previous placement)"/><ComboBoxItem Content="Exit fullscreen maximized"/><ComboBoxItem Content="No action"/></ComboBox></Grid>
                </StackPanel>
                <Button Classes="secondaryAction" Content="Reset all gestures" Click="ResetGestureMatrixClicked" HorizontalAlignment="Left" MinWidth="180" Margin="4,4,0,0" ToolTip.Tip="Return every gesture row in every area to Default and remove all custom gestures."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="mouse-shortcuts" Title="Keyboard shortcuts" Subtitle="Every shortcut, with stock presets" Icon="Hotkeys" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="9">
                <TextBlock Text="Select an action, change its shortcut or add another shortcut. Multiple keys may intentionally perform the same action." Classes="phaseNote"/>
                <Grid ColumnDefinitions="150,220,Auto,*" Margin="6,2,0,0">
                  <TextBlock Text="Hotkey preset" VerticalAlignment="Center"/>
                  <ComboBox x:Name="HotkeyPresetCombo" Grid.Column="1" Width="210" SelectedIndex="0"><ComboBoxItem Content="Glide default"/><ComboBoxItem Content="Windows Photos"/><ComboBoxItem Content="IrfanView"/><ComboBoxItem Content="nomacs"/><ComboBoxItem Content="FastStone"/><ComboBoxItem Content="XnView MP"/></ComboBox>
                  <Button Grid.Column="2" Classes="secondaryAction" Content="Load preset" Click="LoadHotkeyPresetClicked" Margin="10,0,0,0"/>
                </Grid>
                <WrapPanel ItemSpacing="10" LineSpacing="8" Margin="6,0,0,0" controls:SettingsCard.SettingIds="hotkeys.customPresets">
                  <Button x:Name="SaveHotkeyPresetButton" Classes="secondaryAction" Content="Save current as preset..." Click="SaveHotkeyPresetClicked" ToolTip.Tip="Save the keyboard shortcuts as they are now under a name of your choice. The preset then appears in the list above."/>
                  <Button x:Name="RenameHotkeyPresetButton" Classes="secondaryAction" Content="Rename preset..." Click="RenameHotkeyPresetClicked" ToolTip.Tip="Rename the selected custom preset. Built-in presets cannot be renamed."/>
                  <Button x:Name="DeleteHotkeyPresetButton" Classes="secondaryAction" Content="Delete preset" Click="DeleteHotkeyPresetClicked" ToolTip.Tip="Delete the selected custom preset. Built-in presets cannot be deleted."/>
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="6,2,0,0" ColumnSpacing="10">
                  <TextBox x:Name="HotkeyFilterBox" Watermark="Filter shortcuts: action, category or key (for example slideshow, Ctrl, F5)" ToolTip.Tip="Filter the shortcut list as you type. Every word must match the action name, its category or one of its keys." TextChanged="HotkeyFilterChanged">
                    <TextBox.InnerRightContent>
                      <Button x:Name="ClearHotkeyFilterButton" IsVisible="False" Click="ClearHotkeyFilterClicked" Background="Transparent" BorderThickness="0" Padding="8,0" Margin="0" VerticalAlignment="Stretch" Cursor="Hand" Focusable="False" ToolTip.Tip="Clear the filter and show every shortcut"><TextBlock Text="✕" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource BrushMuted}"/></Button>
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="SearchHotkeyButton" Grid.Column="1" Classes="secondaryAction" Content="Search hotkey" Click="SearchHotkeyClicked" controls:SettingsCard.SettingIds="hotkeys.searchHotkey" ToolTip.Tip="Press this, then press a key or combination. The list shows which action it is assigned to, or tells you it is not assigned. Esc cancels."/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="6,0,8,0" ColumnSpacing="10">
                  <TextBlock x:Name="HotkeyCaptureText" Text="" Foreground="{DynamicResource BrushAccent}" FontSize="13" MinHeight="19" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button x:Name="ClearHotkeyLookupButton" Grid.Column="1" Classes="secondaryAction" Content="Show all hotkeys" IsVisible="False" Click="ClearHotkeyLookupClicked"/>
                </Grid>
                <Border Classes="hotkeyTable" Margin="6,2,0,0" controls:SettingsCard.SettingIds="hotkeys.registry">
                  <Grid RowDefinitions="32,*">
                    <Grid Classes="hotkeyHeader" ColumnDefinitions="150,2*,*">
                      <Button x:Name="HotkeySortShortcutButton" Classes="hotkeyHeaderButton" Content="Shortcut" Click="HotkeySortShortcutClicked" ToolTip.Tip="Sort by shortcut (click again to reverse)"/>
                      <Button x:Name="HotkeySortActionButton" Grid.Column="1" Classes="hotkeyHeaderButton" Content="Action" Click="HotkeySortActionClicked" ToolTip.Tip="Sort by action (click again to reverse)"/>
                      <Button x:Name="HotkeySortCategoryButton" Grid.Column="2" Classes="hotkeyHeaderButton" Content="Category" Click="HotkeySortCategoryClicked" ToolTip.Tip="Sort by category (click again to reverse)"/>
                    </Grid>
                    <ListBox x:Name="HotkeyList" Grid.Row="1" Height="335" Classes="hotkeyList" SelectionChanged="HotkeySelectionChanged" DoubleTapped="HotkeyListDoubleTapped"/>
                  </Grid>
                </Border>
                <WrapPanel ItemSpacing="10" LineSpacing="8" Margin="6,2,0,0">
                  <Button x:Name="ChangeShortcutButton" Classes="secondaryAction" Content="Change shortcut" Click="ChangeShortcutClicked"/>
                  <Button x:Name="AddShortcutButton" Classes="secondaryAction" Content="Add shortcut" Click="AddShortcutClicked"/>
                  <Button x:Name="RemoveShortcutButton" Classes="secondaryAction" Content="Remove shortcuts" Click="RemoveShortcutClicked"/>
                  <Button x:Name="ResetHotkeysButton" Classes="secondaryAction" Content="Reset hotkeys" Click="ResetHotkeysClicked"/>
                </WrapPanel>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="mouse-escape-tab" Title="Escape and Tab keys" Subtitle="What Escape does, and whether Tab moves focus between buttons" Icon="Close" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="EscStopsSlideshowCheck" Content="Escape stops slideshow and restores its starting mode"/>
                <CheckBox x:Name="EscExitsFullscreenCheck" Content="Escape exits fullscreen when no slideshow is running"/>
                <CheckBox x:Name="EscWindowedConfirmCheck" Content="Escape in windowed mode asks before closing Glide"/>
                <Button x:Name="ResetEscChoiceButton" Classes="secondaryAction" Content="Clear remembered Escape close choice" Click="ResetEscChoiceClicked" HorizontalAlignment="Left" MinWidth="238" ToolTip.Tip="Return Escape-in-windowed-mode to asking before close"/>
                <CheckBox x:Name="TabFocusNavigationCheck" Content="Allow Tab key to navigate focus through buttons and controls" ToolTip.Tip="When disabled, pressing Tab will not cycle keyboard focus through toolbar buttons and UI controls."/>
            </StackPanel>
          </controls:SettingsCard>
            <!-- A link, not a copy: the Explorer tab's mouse-wheel settings live on Window & navigation > Explorer tab. -->
            <Border Classes="settingsCard">
              <Button x:Name="ExplorerScrollLinkButton" Click="ExplorerScrollLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="14,10" MinHeight="52"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                <Grid ColumnDefinitions="Auto,*">
                  <controls:GlideIconView Kind="Browser" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="settingsCardTitle" Text="Explorer scroll speed and amount →"/>
                    <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="How far the mouse wheel scrolls the Explorer tab. Opens Window &amp; navigation > Explorer tab."/>
                  </StackPanel>
                </Grid>
              </Button>
            </Border>
          </StackPanel>

          <!-- SLIDESHOW &amp; OVERLAYS -->
          <StackPanel x:Name="SlideshowPanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="slideshow-slideshow" Title="Slideshow" Subtitle="Timing, order, looping and what starts with it" Icon="Slideshow" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <Grid ColumnDefinitions="255,140,*" Margin="6,0,0,0"><TextBlock Text="Slideshow interval (ms)" VerticalAlignment="Center"/><NumericUpDown x:Name="SlideshowIntervalBox" Grid.Column="1" Minimum="250" Maximum="600000" Increment="250"/></Grid>
                <Grid ColumnDefinitions="255,200,*" Margin="6,0,0,0"><TextBlock Text="Direction when not shuffled" VerticalAlignment="Center"/><ComboBox x:Name="SlideshowDirectionCombo" Grid.Column="1" Width="190"><ComboBoxItem Content="Forward"/><ComboBoxItem Content="Backward"/></ComboBox></Grid>
                <CheckBox x:Name="SlideshowShuffleCheck" Content="Shuffle images"/>
                <CheckBox x:Name="SlideshowLoopCheck" Content="Loop slideshow"/>
                <CheckBox x:Name="SlideshowCrossFoldersCheck" Content="Continue slideshow across picture folders" ToolTip.Tip="Uses the same sibling/hierarchical folder traversal policy as manual navigation."/>
                <CheckBox x:Name="SlideshowStartFullscreenCheck" Content="Enter fullscreen when slideshow starts"/>
                <CheckBox x:Name="SlideshowPauseInactiveCheck" Content="Pause slideshow while Glide is not the active window"/>
                <CheckBox x:Name="SlideshowQualityIndicatorCheck" Content="Show slideshow playing indicator"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="slideshow-wiw" Title="Window in Window overlays" Subtitle="Image overlays floating on top of the viewer" Icon="Overlays" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Window-in-Window overlays are live. Add images from the viewer status bar; settings below apply to new and selected overlays." Classes="phaseNote"/>
                <Grid ColumnDefinitions="285,150,*" Margin="6,0,0,0"><TextBlock Text="Default overlay opacity (10-100%)" VerticalAlignment="Center"/><NumericUpDown x:Name="OverlayOpacityBox" Grid.Column="1" Minimum="10" Maximum="100"/></Grid>
                <CheckBox x:Name="OverlayHighlightCheck" Content="Highlight the selected overlay with the accent colour"/>
                <Grid ColumnDefinitions="205,150,*" Margin="6,0,0,0"><TextBlock Text="Overlay zoom step (%)" VerticalAlignment="Center"/><NumericUpDown x:Name="OverlayZoomStepBox" Grid.Column="1" Minimum="1" Maximum="100"/></Grid>
                <CheckBox x:Name="OverlayKeyboardZoomCheck" Content="Selected overlay receives keyboard +/- zoom" IsChecked="True"/>
                <CheckBox x:Name="OverlayScaleWithWindowCheck" Content="Scale overlay size proportionally when the Glide window is resized"/>
                <CheckBox x:Name="OverlayRememberZoomCheck" Content="Remember overlay zoom in saved overlay layouts" IsChecked="True"/>
                <CheckBox x:Name="OverlayPersistSessionCheck" Content="Restore overlays automatically on next launch (position, size, zoom, pan and opacity)" ToolTip.Tip="Off by default. Manual Save/Load Layout remains available regardless."/>
                <CheckBox x:Name="OverlayRememberFolderCheck" Content="Remember the last overlay image folder" IsChecked="True"/>
                <Grid ColumnDefinitions="205,*,Auto" ColumnSpacing="7" Margin="6,0,0,0"><TextBlock Text="Default overlay directory" VerticalAlignment="Center"/><TextBox x:Name="OverlayDefaultDirectoryBox" Grid.Column="1"/><Button Grid.Column="2" Classes="secondaryAction" Content="Browse..." Click="BrowseOverlayDefaultDirectoryClicked"/></Grid>
                <CheckBox x:Name="OverlayAbsoluteCoordinatesCheck" Content="Keep overlay coordinates absolute during window/maximize/fullscreen resizing" ToolTip.Tip="Developer override. When enabled, Glide does not reposition overlays to keep them visible after the viewer changes size; this can intentionally leave an overlay clipped or off-screen."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="slideshow-animation" Title="Overlay animation" Subtitle="Let overlays drift around the viewer" Icon="Animation" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Animated overlays move smoothly within the selected region. Right-click an overlay and choose Animate to start or stop movement." Classes="phaseNote" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="205,250,*" Margin="6,0,0,0"><TextBlock Text="Animation region" VerticalAlignment="Center"/><ComboBox x:Name="OverlayAnimationRegionCombo" Grid.Column="1"><ComboBoxItem Content="Anywhere"/><ComboBoxItem Content="Top half"/><ComboBoxItem Content="Bottom half"/><ComboBoxItem Content="Top left quarter"/><ComboBoxItem Content="Top right quarter"/><ComboBoxItem Content="Bottom left quarter"/><ComboBoxItem Content="Bottom right quarter"/></ComboBox></Grid>
                <Grid ColumnDefinitions="205,150,*" Margin="6,0,0,0"><TextBlock Text="Speed (DIPs per second)" VerticalAlignment="Center"/><NumericUpDown x:Name="OverlayAnimationSpeedBox" Grid.Column="1" Minimum="10" Maximum="2000" Increment="10"/></Grid>
                <Grid ColumnDefinitions="205,150,*" Margin="6,0,0,0"><TextBlock Text="Turn interval (ms)" VerticalAlignment="Center"/><NumericUpDown x:Name="OverlayAnimationTurnIntervalBox" Grid.Column="1" Minimum="0" Maximum="60000" Increment="100"/></Grid>
                <Grid ColumnDefinitions="205,150,*" Margin="6,0,0,0"><TextBlock Text="Turn angle (degrees)" VerticalAlignment="Center"/><NumericUpDown x:Name="OverlayAnimationTurnAngleBox" Grid.Column="1" Minimum="0" Maximum="180" Increment="5"/></Grid>
                <CheckBox x:Name="OverlayAnimationPauseCheck" Content="Pause overlay animation while interacting" IsChecked="True"/>
                <CheckBox x:Name="OverlayAnimationAvoidOverlapCheck" Content="Animated overlays avoid overlapping" IsChecked="True"/>
                <Grid ColumnDefinitions="205,250,*" Margin="6,0,0,0"><TextBlock Text="Animation refresh target" VerticalAlignment="Center"/><ComboBox x:Name="OverlayAnimationRefreshRateCombo" Grid.Column="1"><ComboBoxItem Content="60 Hz" Tag="60"/><ComboBoxItem Content="120 Hz" Tag="120"/><ComboBoxItem Content="144 Hz" Tag="144"/><ComboBoxItem Content="160 Hz" Tag="160"/><ComboBoxItem Content="240 Hz" Tag="240"/><ComboBoxItem Content="360 Hz" Tag="360"/></ComboBox></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="slideshow-overlay-mode" Title="Overlay mode" Subtitle="Run all of Glide as a transparent window" Icon="Transparency" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Whole-app Overlay mode removes ordinary Glide chrome and requests real transparent window composition. Transparent PNG regions can reveal the desktop where the platform compositor supports transparency. Normal Glide remains the default." Classes="phaseNote" TextWrapping="Wrap"/>
                <CheckBox x:Name="WholeAppOverlayAlwaysStartCheck" Content="Always start Glide in Overlay / Window-in-Window mode" ToolTip.Tip="Off by default. You can also toggle this from the Overlay-mode context menu."/>
                <CheckBox x:Name="WholeAppOverlayWindowedInteractionsCheck" Content="Use normal windowed image interactions while in Overlay mode" ToolTip.Tip="Off by default. Off = Window-in-Window behavior: left-drag moves the Overlay window. On = normal Glide selection/pan/click behavior. This can also be toggled from Overlay mode's right-click menu."/>
                <CheckBox x:Name="WholeAppOverlayShowDragStripCheck" Content="Show a drag handle near the top" ToolTip.Tip="Off by default. A small rounded handle with a grip line, centred just below the top edge, shown while the mouse is over the Overlay and fading out when it leaves. Drag it to move the window, even when zoomed in. Also in Overlay mode's right-click menu."/>
                <!-- A link: the tooltip delays live on Appearance &amp; viewing > Tooltips. -->
                <Button x:Name="OverlayTooltipLinkButton" Click="TooltipDelayLinkClicked" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,8" MinHeight="44"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:GlideIconView Kind="Info" Classes="settingsCardIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="settingsCardTitle" Text="Tooltip delay →"/>
                      <TextBlock Classes="settingsCardSubtitle" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="How long tooltips wait in Overlay mode. Opens Appearance &amp; viewing > Tooltips."/>
                    </StackPanel>
                  </Grid>
                </Button>
                <CheckBox x:Name="WholeAppOverlayLockPositionCheck" Content="Lock the Overlay window position" ToolTip.Tip="Off by default. Dragging no longer moves the Overlay window (left-drag, Alt+drag, bottom bar, drag strip); panning a zoomed picture still works. Also in Overlay mode's right-click menu."/>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- WINDOWS &amp; DEVELOPER -->
          <StackPanel x:Name="WindowsPanel" IsVisible="False" Spacing="0">
            <controls:SettingsCard CardId="windows-explorer-open" Title="Opening images from Explorer" Subtitle="Open With registration and what happens when you open an image" Icon="OpenWith" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Register Glide in Windows Open With; formats no other app opens get Glide as their default, and another app's default is never changed. Registration is per-user and does not require administrator privileges." Classes="phaseNote"/>
                <WrapPanel ItemSpacing="12" LineSpacing="8" controls:SettingsCard.SettingIds="windows.fileAssociations"><Button x:Name="AddOpenWithButton" Classes="secondaryAction" Content="Add Glide to Open With" Click="AddOpenWithClicked" MinWidth="220"/><Button x:Name="RemoveOpenWithButton" Classes="secondaryAction" Content="Remove Glide Open With entries" Click="RemoveOpenWithClicked" MinWidth="240"/></WrapPanel>
                <Button x:Name="MakeDefaultViewerButton" Classes="secondaryAction" Content="Make Glide the default viewer…" Click="MakeDefaultViewerClicked" MinWidth="240" HorizontalAlignment="Left" ToolTip.Tip="Opens Windows' Default apps page for Glide. Press &quot;Set default&quot; there to open every supported image format with Glide."/>
                <TextBlock x:Name="WindowsIntegrationStatusText" Text="" Classes="phaseNote" TextWrapping="Wrap"/>
                <CheckBox x:Name="ReuseSingleInstanceCheck" Content="Reuse one Glide instance for Explorer image launches" ToolTip.Tip="Enabled by default. Explorer launches are handed to the running Glide before a second UI starts."/>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Opening an image from Explorer" VerticalAlignment="Center"/><ComboBox x:Name="ExternalOpenBehaviorCombo" Grid.Column="1" Width="240"><ComboBoxItem Content="Open in new tab"/><ComboBoxItem Content="Open new window"/><ComboBoxItem Content="Overwrite existing tab"/></ComboBox></Grid>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="If the same image is already open" VerticalAlignment="Center"/><ComboBox x:Name="SameImageBehaviorCombo" Grid.Column="1" Width="240"><ComboBoxItem Content="Open new instance"/><ComboBoxItem Content="Refresh existing image"/><ComboBoxItem Content="Open new tab"/></ComboBox></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="windows-background" Title="Background and Windows startup" Subtitle="Keep Glide ready in the background for instant opening" Icon="Performance" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="SpeedBoostCheck" Content="Launch Speed Boost (keep Glide warm in background for instant image opening)" ToolTip.Tip="When enabled, closing the window keeps the engine warm in the background and in the system tray so double-clicking images in File Explorer opens instantly (~20ms)."/>
                <Grid ColumnDefinitions="260,260,*" Margin="6,0,0,0">
                  <TextBlock Text="Speed Boost tray icon" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SpeedBoostTrayIconCombo" Grid.Column="1" Width="250" ToolTip.Tip="Without a tray icon, launch Glide again (Start menu, shortcut or an image) to bring the background instance back.">
                    <ComboBoxItem Content="Always"/>
                    <ComboBoxItem Content="Only while Glide is closed"/>
                    <ComboBoxItem Content="Never"/>
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="StartWithWindowsInBackgroundCheck" Content="Start Glide with Windows in background" ToolTip.Tip="Automatically starts Glide minimized in the background when Windows boots, enabling instant image viewing anytime."/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="windows-thumbnails" Title="Explorer thumbnails" Subtitle="Glide's thumbnails in Windows Explorer" Icon="Image" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <CheckBox x:Name="ExplorerThumbnailsCheck" Content="Show Glide thumbnails in Windows Explorer" ToolTip.Tip="Registers Glide's native thumbnail provider for supported formats. Thumbnail registration is separate from Open With."/>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Provider mode" VerticalAlignment="Center"/><ComboBox x:Name="ThumbnailModeCombo" Grid.Column="1" Width="240" ToolTip.Tip="Which formats Explorer asks Glide for. Recommended: formats Glide decodes itself plus formats with no other handler. Unsupported only: just the gaps. All: every format Glide opens, replacing other handlers. Custom: keeps the current selection of formats routed to Glide."><ComboBoxItem Content="Recommended"/><ComboBoxItem Content="Glide for unsupported formats only"/><ComboBoxItem Content="Glide for all supported formats"/><ComboBoxItem Content="Custom"/></ComboBox></Grid>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Thumbnail quality" VerticalAlignment="Center"/><ComboBox x:Name="ThumbnailQualityCombo" Grid.Column="1" Width="240" ToolTip.Tip="Fast: bilinear scaling, reuses small camera previews (softer), animated GIFs use frame 1 only. Balanced (default): area-averaging scaling, previews only when they are at least thumbnail size, skips blank first GIF frames. High: decodes at twice the thumbnail size and uses high-quality cubic scaling (sharpest, slowest). Use Refresh thumbnails to rebuild existing ones."><ComboBoxItem Content="Fast"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="High"/></ComboBox></Grid>
                <Grid ColumnDefinitions="260,250,*" Margin="6,0,0,0"><TextBlock Text="Maximum source decode size" VerticalAlignment="Center"/><ComboBox x:Name="ThumbnailMaxSourceCombo" Grid.Column="1" Width="240" ToolTip.Tip="Largest intermediate image Glide decodes for one thumbnail. Automatic follows the size Explorer asks for (up to 2048 px). A smaller cap is faster and uses less memory; thumbnails larger than the cap are enlarged and look softer."><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="512 px"/><ComboBoxItem Content="1024 px"/><ComboBoxItem Content="2048 px"/></ComboBox></Grid>
                <CheckBox x:Name="ThumbnailPreferEmbeddedCheck" Content="Prefer embedded previews (faster for RAW and large files)" ToolTip.Tip="Use the preview stored inside JPEG, TIFF and RAW files instead of decoding the whole image, when it is large enough for the chosen quality. Previews are rotated like the photo and letterbox bars are cropped."/>
                <WrapPanel ItemSpacing="12" LineSpacing="8"><Button Classes="secondaryAction" Content="Apply thumbnail settings" Click="ApplyThumbnailSettingsClicked" MinWidth="200"/><Button Classes="secondaryAction" Content="Restore recommended" Click="RestoreThumbnailDefaultsClicked" MinWidth="180"/><Button Classes="secondaryAction" Content="Refresh thumbnails" Click="RefreshThumbnailsClicked" MinWidth="160"/></WrapPanel>
                <TextBlock x:Name="ThumbnailDiagnosticsText" Text="" Classes="phaseNote" TextWrapping="Wrap"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="windows-external" Title="External programs" Subtitle="Programs to open the current image in (Shift+1 to Shift+3)" Icon="Open" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock x:Name="External1Label" Text="External Program 1 (Shift+1)"/><Grid ColumnDefinitions="*,100" ColumnSpacing="10"><TextBox x:Name="External1Box" IsReadOnly="True"/><Button Grid.Column="1" Classes="secondaryAction" Content="Browse..." Tag="1" Click="BrowseExternalClicked"/></Grid>
                <TextBlock x:Name="External2Label" Text="External Program 2 (Shift+2)"/><Grid ColumnDefinitions="*,100" ColumnSpacing="10"><TextBox x:Name="External2Box" IsReadOnly="True"/><Button Grid.Column="1" Classes="secondaryAction" Content="Browse..." Tag="2" Click="BrowseExternalClicked"/></Grid>
                <TextBlock x:Name="External3Label" Text="External Program 3 (Shift+3)"/><Grid ColumnDefinitions="*,100" ColumnSpacing="10"><TextBox x:Name="External3Box" IsReadOnly="True"/><Button Grid.Column="1" Classes="secondaryAction" Content="Browse..." Tag="3" Click="BrowseExternalClicked"/></Grid>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="windows-diagnostics" Title="Diagnostics" Subtitle="Diagnostic export and startup timing log" Icon="Developer" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="10">
                <TextBlock Text="Diagnostics are permanent product infrastructure. Export always writes the ZIP to Downloads and now includes UI screenshots, geometry, settings state/effect coverage and structural tests." Classes="phaseNote" Margin="0,8,0,0"/>
                <WrapPanel ItemSpacing="12" LineSpacing="8" Margin="0,8,0,0" controls:SettingsCard.SettingIds="developer.diagnostics"><Button Classes="secondaryAction" Content="Run Diagnostics" Click="RunDiagnosticsClicked" MinWidth="190"/><Button x:Name="ExportDiagnosticsButton" Classes="secondaryAction" Content="Export Diagnostic ZIP" Click="ExportDiagnosticsClicked" MinWidth="210"/></WrapPanel>
                <CheckBox x:Name="StartupDiagnosticsCheck" Content="Write lightweight startup timing JSONL"/>
            </StackPanel>
          </controls:SettingsCard>
            <!-- Back up and restore and Reset Glide share one data-driven tick-box list (DataCategorySelector, built from
                 GlideDataCategoryCatalog in SettingsWindow.Backup.cs / SettingsWindow.Reset.cs): the hosts below stay empty here. -->
            <controls:SettingsCard CardId="windows-backup" Title="Back up and restore" Subtitle="Export or import Glide's settings and data" Icon="SaveAs" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="0">
                <StackPanel x:Name="BackupCategoryHost" controls:SettingsCard.SettingIds="backup.card,backup.export,backup.import"/>
                <TextBlock x:Name="BackupNoteText" Classes="phaseNote" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Saves one .glidebackup file you can import on this or another PC. Not included: caches, registry and Windows startup entries (they belong to this PC or are rebuilt), and external programs."/>
                <TextBlock x:Name="BackupResultText" Classes="phaseNote" IsVisible="False" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </controls:SettingsCard>
            <controls:SettingsCard CardId="windows-reset" Title="Reset Glide" Subtitle="Choose what to wipe and start fresh" Icon="Reset" IconBrush="#E5645A" IsExpanded="False">
              <StackPanel Classes="settingsCardBody" Spacing="0">
                <StackPanel x:Name="ResetCategoryHost" controls:SettingsCard.SettingIds="reset.card"/>
                <TextBlock x:Name="ResetResultText" Classes="phaseNote" IsVisible="False" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </controls:SettingsCard>
          </StackPanel>

          <!-- SEARCH -->
          <StackPanel x:Name="SearchPanel" IsVisible="False" Spacing="8"/>
        </StackPanel>
      </ScrollViewer>

      <!-- footer -->
      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource BrushFooter}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="14,6,20,6">
          <!-- Footer (approved design): sidebar-wide, two rows.
               Row 1: version left, "Always expand" + switch right. Row 2: two equal buttons: Restore defaults (options only,
               the same scope as Reset Glide > All settings) and "Reset Glide" (opens the Reset Glide card for everything else). -->
          <Grid x:Name="SettingsFooterLeft" Width="196" HorizontalAlignment="Left" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
            <TextBlock x:Name="AboutVersionText" Text="Glide" Foreground="{DynamicResource BrushMuted}" FontSize="13" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="Open every Settings section expanded">
              <TextBlock Text="Always expand" FontSize="13" VerticalAlignment="Center"/>
              <ToggleButton x:Name="SettingsAlwaysExpandSwitch" Classes="footerSwitch" VerticalAlignment="Center" ToolTip.Tip="Open every Settings section expanded"/>
            </StackPanel>
            <Grid x:Name="FooterResetButtons" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button x:Name="RestoreDefaultsButton" Classes="secondaryAction footerPair" Click="RestoreDefaultsClicked"
                      AutomationProperties.Name="Restore defaults"
                      ToolTip.Tip="Restore defaults: put every option back to its default. Settings only: hotkeys, mouse gestures, window positions, history and other data are kept. Nothing is saved until Apply or OK.">
                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="&#x21BA;" VerticalAlignment="Center"/><TextBlock x:Name="RestoreDefaultsLabel" Text="Defaults" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="OpenResetGlideButton" Grid.Column="1" Classes="secondaryAction footerPair" Click="OpenResetGlideClicked"
                      AutomationProperties.Name="Reset Glide: more reset options"
                      ToolTip.Tip="More reset options: history, window positions, hotkeys, caches, Windows integration">
                <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock x:Name="OpenResetGlideLabel" Text="Reset Glide" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/><TextBlock Text="&#x2192;" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </Grid>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <StackPanel x:Name="DirtySummaryHost" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="0" Background="Transparent"
                        Focusable="True" Cursor="Hand" AutomationProperties.Name="Show the list of changes">
              <!-- Own hover/click popup for the change list (not the ToolTip service): see UpdateDirtyState. -->
              <Popup x:Name="DirtySummaryPopup" PlacementTarget="{Binding #DirtySummaryHost}" Placement="Top" VerticalOffset="-6"
                     IsLightDismissEnabled="False" Topmost="False">
                <Border Background="{DynamicResource ToolTipBackground}" BorderBrush="{DynamicResource ToolTipBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,5" MaxWidth="560" IsHitTestVisible="False">
                  <TextBlock x:Name="DirtySummaryPopupText" Foreground="{DynamicResource ToolTipForeground}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
              </Popup>
              <TextBlock x:Name="DirtyText" IsHitTestVisible="False" HorizontalAlignment="Right" Foreground="{DynamicResource BrushMuted}"/>
              <TextBlock x:Name="DirtyHintText" IsHitTestVisible="False" HorizontalAlignment="Right" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontStyle="Italic" Text="Hover or click to view changes"/>
            </StackPanel>
            <Button Classes="secondaryAction" Height="34" MinWidth="80" Content="Cancel" Click="CancelClicked"/>
            <Button x:Name="ApplyButton" Classes="secondaryAction" Height="34" MinWidth="80" Content="Apply" Click="ApplyClicked"/>
            <Button Classes="primaryAction" Height="34" MinWidth="80" Content="OK" Click="OkClicked"/>
          </StackPanel>
        </Grid>
      </Border>
  </Grid>
</Window>
