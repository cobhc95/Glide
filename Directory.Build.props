<Project>
  <PropertyGroup>
    <!-- 5.0.1: .NET 10 LTS (.NET 8 support ended 2026-11-10). One TFM for every project, including the
         tests and tools\perf\Glide.PerfBench. See docs\NET10-MIGRATION-PLAN.md. -->
    <TargetFramework>net10.0</TargetFramework>
    <Version>5.0.7</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- Pinned to 12 (was `latest`): SDK upgrades must not silently change language semantics.
         Kept at 12 on the .NET 10 SDK; raising it (C# 14) is a separate change with its own test pass. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Hygiene: warnings stay non-fatal (too noisy to enforce), but editor/IDE style rules are
         enforced at build time so formatting drift fails locally before review. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Recommended analyzer ruleset; NOT All (too noisy for this codebase). -->
    <AnalysisMode>Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <TieredPGO Condition="'$(Configuration)' == 'Release'">true</TieredPGO>
    <!-- Release builds ship without PDB debug symbols so each build leaves no .pdb bloat behind. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <!-- Cold launch is Glide 3.0's overriding constraint. Composite R2R trades some publish size
         and build time for less cross-assembly JIT/runtime work before first useful pixels. -->
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' != 'true'">true</PublishReadyToRunComposite>
    <!-- Release size. Exception messages and stack traces stay on so error text and crash reports remain useful.
         Known follow-up (docs\NET10-MIGRATION-PLAN.md, WP7): the ILCompiler targets do not read
         IlcOptimizationPreference (the real property is OptimizationPreference), so this line is a no-op and
         the exe uses the default blended optimization. Left unchanged on purpose: switching it changes speed
         and size and needs its own measured release. -->
    <IlcOptimizationPreference Condition="'$(PublishAot)' == 'true'">Size</IlcOptimizationPreference>
    <EventSourceSupport Condition="'$(PublishAot)' == 'true'">false</EventSourceSupport>
    <MetricsSupport Condition="'$(PublishAot)' == 'true'">false</MetricsSupport>
    <HttpActivityPropagationSupport Condition="'$(PublishAot)' == 'true'">false</HttpActivityPropagationSupport>
    <DebuggerSupport Condition="'$(PublishAot)' == 'true'">false</DebuggerSupport>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)dist\Glide.Native.dll')">
    <None Include="$(MSBuildThisFileDirectory)dist\Glide.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <!-- Clean builds delete dist\ before managed build/test; fall back to the freshly built native
       bridge so tests exercising the WIC encoder/decoder see the current Glide.Native.dll. -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)dist\Glide.Native.dll') And Exists('$(MSBuildThisFileDirectory)native\Glide.Native\build\Release\Glide.Native.dll')">
    <None Include="$(MSBuildThisFileDirectory)native\Glide.Native\build\Release\Glide.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <!-- Explorer thumbnail provider: copy the freshly built DLL next to dev/test outputs so a dev run
       reports the provider correctly and the headless provider tests (ShellThumbnailProviderTests)
       exercise the current native code in-process. Nothing is registered by copying it. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)native\Glide.ShellThumbnail\build\Release\Glide.ShellThumbnail.dll')">
    <None Include="$(MSBuildThisFileDirectory)native\Glide.ShellThumbnail\build\Release\Glide.ShellThumbnail.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <!-- Bundled optional codec provider (codecs\glidecodecs.dll + manifest + generated index, built by
       tools\build-codecs.ps1). Dev runs and tests load it from <output>\codecs exactly as a release does
       from <app>\codecs; it is still only hashed/loaded when an AVIF/HEIC/JXL/JPEG 2000 file is opened.
       Releases receive it through build.cmd's codecs -> dist\codecs copy, so publish is excluded here. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)codecs\codecs.index.json') And '$(PublishAot)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)codecs\*.dll;$(MSBuildThisFileDirectory)codecs\*.glidecodec.json;$(MSBuildThisFileDirectory)codecs\codecs.index.json">
      <Link>codecs\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
