<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Public Glide release label follows feature-dot / bug-hyphen convention. 3.3 adds fullscreen-exit, duplicate-image, Overlay pin, status-wrap and resize-input capabilities. -->
    <Version>3.5.0</Version>
    <AssemblyVersion>3.5.0.0</AssemblyVersion>
    <FileVersion>3.5.0.0</FileVersion>
    <InformationalVersion>3.5</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <TieredPGO Condition="'$(Configuration)' == 'Release'">true</TieredPGO>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Cold launch is Glide 3.0's overriding constraint. Composite R2R trades some publish size
         and build time for less cross-assembly JIT/runtime work before first useful pixels. -->
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRunComposite>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
