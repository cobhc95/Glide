// Version resource for Glide.ShellThumbnail.dll. Generated by CMake from Directory.Build.props so the
// provider DLL carries the same version as Glide.exe; Settings -> Explorer thumbnails reads it to show
// which provider build Explorer is actually loading.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GLIDE_VERSION_MAJOR@,@GLIDE_VERSION_MINOR@,@GLIDE_VERSION_PATCH@,0
 PRODUCTVERSION @GLIDE_VERSION_MAJOR@,@GLIDE_VERSION_MINOR@,@GLIDE_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "cobhc95"
            VALUE "FileDescription", "Glide Explorer Thumbnail Provider"
            VALUE "FileVersion", "@GLIDE_VERSION@.0"
            VALUE "InternalName", "Glide.ShellThumbnail"
            VALUE "OriginalFilename", "Glide.ShellThumbnail.dll"
            VALUE "ProductName", "Glide Image Viewer"
            VALUE "ProductVersion", "@GLIDE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
