# Generated lazy codec routing index (shipped inside the published app, not source)
codecs/codecs.index.json

# Build symbols, test results and local editor state (never committed)
*.pdb
TestResults/
coverage/
.vscode/

# Local-only working notes (feedback-round queues, design mockups): never committed or packaged
docs/QUEUE-*.md
docs/mockups/

# Codec libraries are rebuilt by build.cmd (tools/build-codecs.ps1 and the Glide.ThumbnailCodecs publish)
codecs/*.dll
